//@version=5
indicator("SMC 2.0 - Unmitigated Extreme OB (Boundary Entry & 8-10% Pump)", "SMC 2.0 BOUNDARY SNIPER", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================================
// 1. USER INPUTS & STRATEGY RULES
// ============================================================================
grp_core = "🏛️ SMC 2.0 Core Rules (User Customized)"
min_pump_pct   = input.float(8.0, "Min Displacement Pump % (8% - 10%)", minval=5.0, maxval=25.0, step=0.5, group=grp_core, tooltip="Price must pump minimum 8% to 10% after FVG before returning")
swing_len      = input.int(10, "Swing Pivot Lookback", minval=5, maxval=50, group=grp_core, tooltip="Bars to verify absolute Swing High / Swing Low anchor")
max_tap_window = input.int(40, "Max Freshness Tap Window (Bars)", minval=10, maxval=80, group=grp_core, tooltip="Max bars allowed for price to return and 1st tap the boundary")

grp_risk = "🎯 Tier-1 Target & Risk Settings"
leverage       = input.float(5.0, "Leverage Multiplier (x)", minval=1.0, maxval=50.0, step=1.0, group=grp_risk)
tp_roe_pct     = input.float(12.20, "Take Profit (TP) ROE %", minval=1.0, maxval=100.0, step=0.1, group=grp_risk, tooltip="+12.20% ROE at 5x = +2.44% raw spot move")
sl_roe_pct     = input.float(12.00, "Stop Loss (SL) ROE %", minval=1.0, maxval=100.0, step=0.1, group=grp_risk, tooltip="-12.00% ROE at 5x = -2.40% raw spot move")
use_ob_low_sl  = input.bool(false, "Anchor SL Below OB Low (Recommended)", group=grp_risk, tooltip="If true, SL will protect below the OB low rather than fixed 2.4%")

grp_style = "🎨 Visual Chart Styling"
col_bull_ob    = input.color(color.new(#f59e0b, 78), "Bullish Extreme OB Box", group=grp_style)
col_bear_ob    = input.color(color.new(#8b5cf6, 78), "Bearish Extreme OB Box", group=grp_style)
col_entry_line = input.color(#00e5ff, "OB Boundary Entry Line", group=grp_style)
col_tp_line    = input.color(#00e676, "Target TP Line (+12.20% ROE)", group=grp_style)
col_sl_line    = input.color(#ff1744, "Stop Loss Line (-12.00% ROE)", group=grp_style)

// Math Conversions
tp_price_pct = (tp_roe_pct / 100.0) / leverage  // +2.44% spot price move
sl_price_pct = (sl_roe_pct / 100.0) / leverage  // -2.40% spot price move

// ============================================================================
// 2. EXTREME ORDER BLOCK + CANDLE 2/3 FVG + 8-10% PUMP DETECTION
// ============================================================================

// Check Pivot Low / High
is_lowest_pivot  = low[3] == ta.lowest(low, swing_len + 3)
is_highest_pivot = high[3] == ta.highest(high, swing_len + 3)

// Strict Opposite Candle Rule (Pillar 2)
// Bullish OB: Must be strict RED candle at swing low
is_red_candle   = close[3] < open[3]
// Bearish OB: Must be strict GREEN candle at swing high
is_green_candle = close[3] > open[3]

// Judas Sweep: Wick must sweep previous lows/highs (Pillar 3)
prev_lows  = ta.lowest(low[4], 5)
prev_highs = ta.highest(high[4], 5)
is_judas_bull = low[3] <= prev_lows
is_judas_bear = high[3] >= prev_highs

// Fair Value Gap (FVG) on 2nd or 3rd Candle Rule:
// Candle 2 FVG: low[1] > high[3] (2nd candle void)
// Candle 3 FVG: low[0] > high[2] (3rd candle void)
fvg_c2_bull = low[1] > high[3]
fvg_c3_bull = low[0] > high[2]
has_bull_fvg = fvg_c2_bull or fvg_c3_bull

fvg_c2_bear = high[1] < low[3]
fvg_c3_bear = high[0] < low[2]
has_bear_fvg = fvg_c2_bear or fvg_c3_bear

// Minimum 8% to 10% Pump / Dump Displacement
recent_max_high = ta.highest(high, 10)
recent_min_low  = ta.lowest(low, 10)
disp_gain = (recent_max_high - low[3]) / low[3]
disp_drop = (high[3] - recent_min_low) / high[3]

has_disp_bull = disp_gain >= (min_pump_pct / 100.0)
has_disp_bear = disp_drop >= (min_pump_pct / 100.0)

// Qualified Extreme OBs
valid_bull_ob = is_lowest_pivot and is_red_candle and is_judas_bull and has_bull_fvg and has_disp_bull
valid_bear_ob = is_highest_pivot and is_green_candle and is_judas_bear and has_bear_fvg and has_disp_bear

// ============================================================================
// 3. STATE TRACKING FOR UNMITIGATED (VIRGIN) ORDER BLOCKS
// ============================================================================
type VirginOB
    bool is_bull
    int start_bar
    float ob_high
    float ob_low
    float entry_boundary
    float tp_price
    float sl_price
    bool tapped
    int tap_bar
    bool completed
    box ob_box
    line entry_line
    line tp_line
    line sl_line

var VirginOB[] active_obs = array.new<VirginOB>()

// ============================================================================
// 4. DRAWING FRESH UNMITIGATED ORDER BLOCKS
// ============================================================================
if valid_bull_ob
    float o_high = high[3]
    float o_low  = low[3]
    // 50% MT REMOVED: Entry is strictly the OB Boundary (ob_high)
    float entry_boundary = o_high
    float tp = entry_boundary * (1.0 + tp_price_pct)
    float sl = use_ob_low_sl ? math.min(o_low * 0.998, entry_boundary * (1.0 - sl_price_pct)) : entry_boundary * (1.0 - sl_price_pct)
    int s_bar = bar_index - 3

    box b = box.new(s_bar, o_high, bar_index + 12, o_low, border_color=color.new(#f59e0b, 20), border_width=1, bgcolor=col_bull_ob)
    line l_entry = line.new(s_bar, entry_boundary, bar_index + 12, entry_boundary, color=col_entry_line, width=1, style=line.style_dashed)
    
    VirginOB new_ob = VirginOB.new(true, s_bar, o_high, o_low, entry_boundary, tp, sl, false, 0, false, b, l_entry, na, na)
    array.push(active_obs, new_ob)

if valid_bear_ob
    float o_high = high[3]
    float o_low  = low[3]
    // 50% MT REMOVED: Entry is strictly the OB Boundary (ob_low)
    float entry_boundary = o_low
    float tp = entry_boundary * (1.0 - tp_price_pct)
    float sl = use_ob_low_sl ? math.max(o_high * 1.002, entry_boundary * (1.0 + sl_price_pct)) : entry_boundary * (1.0 + sl_price_pct)
    int s_bar = bar_index - 3

    box b = box.new(s_bar, o_high, bar_index + 12, o_low, border_color=color.new(#8b5cf6, 20), border_width=1, bgcolor=col_bear_ob)
    line l_entry = line.new(s_bar, entry_boundary, bar_index + 12, entry_boundary, color=col_entry_line, width=1, style=line.style_dashed)
    
    VirginOB new_ob = VirginOB.new(false, s_bar, o_high, o_low, entry_boundary, tp, sl, false, 0, false, b, l_entry, na, na)
    array.push(active_obs, new_ob)

// ============================================================================
// 5. 1st TAP ON OB BOUNDARY = LONG / SHORT ENTRY
// ============================================================================
if array.size(active_obs) > 0
    for i = array.size(active_obs) - 1 to 0
        VirginOB ob = array.get(active_obs, i)
        
        if not ob.completed
            // Extend box & boundary entry line forward until resolved
            box.set_right(ob.ob_box, bar_index)
            line.set_x2(ob.entry_line, bar_index)
            
            // Check 1st Tap on Boundary if still unmitigated
            if not ob.tapped
                int bars_alive = bar_index - ob.start_bar
                
                // Expired unmitigated zone check
                if bars_alive > max_tap_window
                    ob.completed := true
                else
                    // Bullish 1st Tap: Price touches OB Top Boundary (Low <= ob.entry_boundary)
                    if ob.is_bull
                        bool tapped_boundary = low <= ob.entry_boundary and low > ob.sl_price
                        
                        if tapped_boundary
                            ob.tapped := true
                            ob.tap_bar := bar_index
                            
                            // Draw TP & SL Lines
                            ob.tp_line := line.new(bar_index, ob.tp_price, bar_index + 20, ob.tp_price, color=col_tp_line, width=2, style=line.style_solid)
                            ob.sl_line := line.new(bar_index, ob.sl_price, bar_index + 20, ob.sl_price, color=col_sl_line, width=1, style=line.style_dashed)
                            
                            // Visual Marker: LONG ON BOUNDARY TOUCH
                            label.new(bar_index, low, "🚀 LONG 1st TAP\nBoundary: " + str.tostring(ob.entry_boundary, "#.#####") + "\nPump: ≥" + str.tostring(min_pump_pct, "#") + "% Passed", 
                                      color=color.new(#00e676, 15), textcolor=color.white, style=label.style_label_up, size=size.small)
                            alert("SMC 2.0 LONG EXECUTED on Unmitigated OB Boundary! Entry: " + str.tostring(ob.entry_boundary), alert.freq_once_per_bar_close)

                    // Bearish 1st Tap: Price touches OB Bottom Boundary (High >= ob.entry_boundary)
                    else
                        bool tapped_boundary = high >= ob.entry_boundary and high < ob.sl_price
                        
                        if tapped_boundary
                            ob.tapped := true
                            ob.tap_bar := bar_index
                            
                            // Draw TP & SL Lines
                            ob.tp_line := line.new(bar_index, ob.tp_price, bar_index + 20, ob.tp_price, color=col_tp_line, width=2, style=line.style_solid)
                            ob.sl_line := line.new(bar_index, ob.sl_price, bar_index + 20, ob.sl_price, color=col_sl_line, width=1, style=line.style_dashed)
                            
                            // Visual Marker: SHORT ON BOUNDARY TOUCH
                            label.new(bar_index, high, "🔻 SHORT 1st TAP\nBoundary: " + str.tostring(ob.entry_boundary, "#.#####") + "\nDrop: ≥" + str.tostring(min_pump_pct, "#") + "% Passed", 
                                      color=color.new(#ff1744, 15), textcolor=color.white, style=label.style_label_down, size=size.small)
                            alert("SMC 2.0 SHORT EXECUTED on Unmitigated OB Boundary! Entry: " + str.tostring(ob.entry_boundary), alert.freq_once_per_bar_close)

            // Monitor TP (+12.20% ROE) / SL Outcomes once tapped
            else
                if not na(ob.tp_line)
                    line.set_x2(ob.tp_line, bar_index)
                if not na(ob.sl_line)
                    line.set_x2(ob.sl_line, bar_index)
                    
                // Long Outcome Monitor
                if ob.is_bull
                    if high >= ob.tp_price
                        label.new(bar_index, high, "🏆 TP HIT!\n+" + str.tostring(tp_roe_pct, "#.#") + "% ROE", 
                                  color=#00e676, textcolor=color.black, style=label.style_label_down, size=size.small)
                        ob.completed := true
                        alert("SMC 2.0 TAKE PROFIT HIT! +" + str.tostring(tp_roe_pct) + "% ROE", alert.freq_once_per_bar_close)
                    else if low <= ob.sl_price
                        label.new(bar_index, low, "❌ SL HIT\n-" + str.tostring(sl_roe_pct, "#.#") + "% ROE", 
                                  color=#ff1744, textcolor=color.white, style=label.style_label_up, size=size.small)
                        ob.completed := true

                // Short Outcome Monitor
                else
                    if low <= ob.tp_price
                        label.new(bar_index, low, "🏆 TP HIT!\n+" + str.tostring(tp_roe_pct, "#.#") + "% ROE", 
                                  color=#00e676, textcolor=color.black, style=label.style_label_up, size=size.small)
                        ob.completed := true
                        alert("SMC 2.0 TAKE PROFIT HIT! +" + str.tostring(tp_roe_pct) + "% ROE", alert.freq_once_per_bar_close)
                    else if high >= ob.sl_price
                        label.new(bar_index, high, "❌ SL HIT\n-" + str.tostring(sl_roe_pct, "#.#") + "% ROE", 
                                  color=#ff1744, textcolor=color.white, style=label.style_label_down, size=size.small)
                        ob.completed := true
