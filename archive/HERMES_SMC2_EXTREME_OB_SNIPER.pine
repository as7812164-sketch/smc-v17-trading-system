//@version=5
indicator("HERMES 3.5 & SMC 2.0 - Boundary Entry (8-10% Pump & FVG)", "HERMES SMC 2.0 BOUNDARY", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ============================================================================
// 1. INPUT SETTINGS & USER CONFIGURATION (UPDATED RULES)
// ============================================================================
grp_smc = "🏛️ SMC 2.0: Boundary Entry & 8-10% Pump Rules"
min_disp_pct   = input.float(8.0, "Min Displacement Pump %", minval=5.0, maxval=25.0, step=0.5, group=grp_smc, tooltip="User Rule: Minimum 8% to 10% pump required after FVG")
entry_mode     = input.string("OB Boundary (Outer Edge)", "Entry Trigger Point", options=["OB Boundary (Outer Edge)", "50% Mean Threshold"], group=grp_smc, tooltip="OB Boundary triggers immediately when price touches the top edge of the OB")
swing_len      = input.int(10, "Swing Pivot Lookback", minval=5, maxval=50, group=grp_smc, tooltip="Bars to verify absolute Swing High / Swing Low anchor")
max_tap_window = input.int(35, "Max Freshness Tap Window", minval=10, maxval=60, group=grp_smc, tooltip="Maximum bars allowed for unmitigated OB to be 1st tapped")

grp_targets = "🎯 Target & Risk Settings (Tier 1 Pure)"
leverage       = input.float(5.0, "Leverage Multiplier (x)", minval=1.0, maxval=50.0, step=1.0, group=grp_targets)
tp_roe_pct     = input.float(12.20, "Take Profit (TP) ROE %", minval=1.0, maxval=100.0, step=0.1, group=grp_targets, tooltip="+12.20% ROE at 5x = +2.44% raw spot move")
sl_roe_pct     = input.float(12.00, "Stop Loss (SL) ROE %", minval=1.0, maxval=100.0, step=0.1, group=grp_targets, tooltip="-12.00% ROE at 5x = -2.40% raw spot move")

grp_visuals = "🎨 Visual Colors & Styling"
col_bull_ob    = input.color(color.new(#f59e0b, 75), "Bullish Extreme OB Box", group=grp_visuals)
col_bear_ob    = input.color(color.new(#8b5cf6, 75), "Bearish Extreme OB Box", group=grp_visuals)
col_entry_line = input.color(#00e5ff, "OB Boundary Entry Line", group=grp_visuals)
col_tp_line    = input.color(#00e676, "Take Profit Target Line", group=grp_visuals)
col_sl_line    = input.color(#ff1744, "Stop Loss Line", group=grp_visuals)

// Calculations
tp_price_pct = (tp_roe_pct / 100.0) / leverage  // +2.44%
sl_price_pct = (sl_roe_pct / 100.0) / leverage  // -2.40%

// ============================================================================
// 2. EXTREME ORDER BLOCK + FVG (CANDLE 2 OR 3) + 8-10% PUMP
// ============================================================================

// Check Pivot Low / High
is_lowest_pivot  = low[3] == ta.lowest(low, swing_len + 3)
is_highest_pivot = high[3] == ta.highest(high, swing_len + 3)

// Strict Opposite Candle Rule
// Bullish OB MUST be a strict Bearish (Red) Candle at swing low
is_red_candle   = close[3] < open[3]
// Bearish OB MUST be a strict Bullish (Green) Candle at swing high
is_green_candle = close[3] > open[3]

// Judas Liquidity Sweep (Takes prior liquidity)
prev_lows  = ta.lowest(low[4], 5)
prev_highs = ta.highest(high[4], 5)
is_judas_bull = low[3] <= prev_lows
is_judas_bear = high[3] >= prev_highs

// FVG on 2nd or 3rd Candle Rule:
// Candle 2 FVG: low[1] > high[3] (2 candles after OB)
// Candle 3 FVG: low[0] > high[2] (3 candles after OB)
fvg_candle_2_bull = low[1] > high[3]
fvg_candle_3_bull = low[0] > high[2]
has_bull_fvg      = fvg_candle_2_bull or fvg_candle_3_bull

fvg_candle_2_bear = high[1] < low[3]
fvg_candle_3_bear = high[0] < low[2]
has_bear_fvg      = fvg_candle_2_bear or fvg_candle_3_bear

// Minimum 8% to 10% Pump / Dump Check
disp_gain = (ta.highest(high, 8) - low[3]) / low[3]
disp_drop = (high[3] - ta.lowest(low, 8)) / high[3]
has_disp_bull = disp_gain >= (min_disp_pct / 100.0)
has_disp_bear = disp_drop >= (min_disp_pct / 100.0)

// Confirmed Extreme OBs
valid_bull_ob = is_lowest_pivot and is_red_candle and is_judas_bull and has_bull_fvg and has_disp_bull
valid_bear_ob = is_highest_pivot and is_green_candle and is_judas_bear and has_bear_fvg and has_disp_bear

// ============================================================================
// 3. STATE TRACKING FOR UNMITIGATED ORDER BLOCKS
// ============================================================================
type OrderBlock
    bool is_bull
    int start_bar
    float ob_high
    float ob_low
    float entry_price
    float tp_price
    float sl_price
    bool tapped
    int tap_bar
    bool completed
    box ob_box
    line entry_line
    line tp_line
    line sl_line

var OrderBlock[] active_obs = array.new<OrderBlock>()

// ============================================================================
// 4. DRAWING NEW UNMITIGATED ORDER BLOCKS
// ============================================================================
if valid_bull_ob
    float o_high = high[3]
    float o_low  = low[3]
    // User Rule: Entry is OB Boundary (ob_high for Bullish OB)
    float entry_p = entry_mode == "OB Boundary (Outer Edge)" ? o_high : ((o_high + o_low) / 2.0)
    float tp      = entry_p * (1.0 + tp_price_pct)
    float sl      = entry_p * (1.0 - sl_price_pct)
    int s_bar     = bar_index - 3

    box b = box.new(s_bar, o_high, bar_index + 12, o_low, border_color=color.new(#f59e0b, 20), border_width=1, bgcolor=col_bull_ob)
    line l_entry = line.new(s_bar, entry_p, bar_index + 12, entry_p, color=col_entry_line, width=1, style=line.style_dashed)
    
    OrderBlock new_ob = OrderBlock.new(true, s_bar, o_high, o_low, entry_p, tp, sl, false, 0, false, b, l_entry, na, na)
    array.push(active_obs, new_ob)

if valid_bear_ob
    float o_high = high[3]
    float o_low  = low[3]
    // User Rule: Entry is OB Boundary (ob_low for Bearish OB)
    float entry_p = entry_mode == "OB Boundary (Outer Edge)" ? o_low : ((o_high + o_low) / 2.0)
    float tp      = entry_p * (1.0 - tp_price_pct)
    float sl      = entry_p * (1.0 + sl_price_pct)
    int s_bar     = bar_index - 3

    box b = box.new(s_bar, o_high, bar_index + 12, o_low, border_color=color.new(#8b5cf6, 20), border_width=1, bgcolor=col_bear_ob)
    line l_entry = line.new(s_bar, entry_p, bar_index + 12, entry_p, color=col_entry_line, width=1, style=line.style_dashed)
    
    OrderBlock new_ob = OrderBlock.new(false, s_bar, o_high, o_low, entry_p, tp, sl, false, 0, false, b, l_entry, na, na)
    array.push(active_obs, new_ob)

// ============================================================================
// 5. 1st TAP ON OB BOUNDARY (EXECUTES LONG / SHORT)
// ============================================================================
if array.size(active_obs) > 0
    for i = array.size(active_obs) - 1 to 0
        OrderBlock ob = array.get(active_obs, i)
        
        if not ob.completed
            // Extend box & entry line until resolved
            box.set_right(ob.ob_box, bar_index)
            line.set_x2(ob.entry_line, bar_index)
            
            // Check 1st Tap on Boundary if not yet tapped
            if not ob.tapped
                int bars_since_creation = bar_index - ob.start_bar
                
                // Expiry guard
                if bars_since_creation > max_tap_window
                    ob.completed := true
                else
                    // Bullish 1st Tap: Price touches OB Boundary (Low <= ob.entry_price)
                    if ob.is_bull
                        bool tapped_boundary = low <= ob.entry_price and low > ob.sl_price
                        
                        if tapped_boundary
                            ob.tapped := true
                            ob.tap_bar := bar_index
                            
                            // Draw TP & SL Lines
                            ob.tp_line := line.new(bar_index, ob.tp_price, bar_index + 15, ob.tp_price, color=col_tp_line, width=2, style=line.style_solid)
                            ob.sl_line := line.new(bar_index, ob.sl_price, bar_index + 15, ob.sl_price, color=col_sl_line, width=1, style=line.style_dashed)
                            
                            // Label Execution (LONG ON BOUNDARY TAP)
                            label.new(bar_index, low, "🚀 LONG 1st TAP @ BOUNDARY\nEntry: " + str.tostring(ob.entry_price, "#.#####") + "\nUnmitigated OB Hit!", 
                                      color=color.new(#00e676, 20), textcolor=color.white, style=label.style_label_up, size=size.small)
                            alert("SMC 2.0 LONG 1st TAP on OB Boundary Triggered! Entry: " + str.tostring(ob.entry_price), alert.freq_once_per_bar_close)

                    // Bearish 1st Tap: Price touches OB Boundary (High >= ob.entry_price)
                    else
                        bool tapped_boundary = high >= ob.entry_price and high < ob.sl_price
                        
                        if tapped_boundary
                            ob.tapped := true
                            ob.tap_bar := bar_index
                            
                            // Draw TP & SL Lines
                            ob.tp_line := line.new(bar_index, ob.tp_price, bar_index + 15, ob.tp_price, color=col_tp_line, width=2, style=line.style_solid)
                            ob.sl_line := line.new(bar_index, ob.sl_price, bar_index + 15, ob.sl_price, color=col_sl_line, width=1, style=line.style_dashed)
                            
                            // Label Execution (SHORT ON BOUNDARY TAP)
                            label.new(bar_index, high, "🔻 SHORT 1st TAP @ BOUNDARY\nEntry: " + str.tostring(ob.entry_price, "#.#####") + "\nUnmitigated OB Hit!", 
                                      color=color.new(#ff1744, 20), textcolor=color.white, style=label.style_label_down, size=size.small)
                            alert("SMC 2.0 SHORT 1st TAP on OB Boundary Triggered! Entry: " + str.tostring(ob.entry_price), alert.freq_once_per_bar_close)

            // Monitor TP / SL Outcomes once tapped
            else
                if not na(ob.tp_line)
                    line.set_x2(ob.tp_line, bar_index)
                if not na(ob.sl_line)
                    line.set_x2(ob.sl_line, bar_index)
                    
                // Long Outcome
                if ob.is_bull
                    if high >= ob.tp_price
                        label.new(bar_index, high, "🏆 TP HIT!\n+" + str.tostring(tp_roe_pct, "#.#") + "% ROE", 
                                  color=#00e676, textcolor=color.black, style=label.style_label_down, size=size.small)
                        ob.completed := true
                        alert("SMC 2.0 TAKE PROFIT HIT! +" + str.tostring(tp_roe_pct) + "% ROE", alert.freq_once_per_bar_close)
                    else if low <= ob.sl_price
                        label.new(bar_index, low, "❌ SL HIT\n-" + str.tostring(sl_roe_pct, "#.#") + "% ROE", 
                                  color=#ff1744, textcolor=color.white, style=label.style_label_up, size=size.small)
                        ob.completed := true

                // Short Outcome
                else
                    if low <= ob.tp_price
                        label.new(bar_index, low, "🏆 TP HIT!\n+" + str.tostring(tp_roe_pct, "#.#") + "% ROE", 
                                  color=#00e676, textcolor=color.black, style=label.style_label_up, size=size.small)
                        ob.completed := true
                        alert("SMC 2.0 TAKE PROFIT HIT! +" + str.tostring(tp_roe_pct) + "% ROE", alert.freq_once_per_bar_close)
                    else if high >= ob.sl_price
                        label.new(bar_index, high, "❌ SL HIT\n-" + str.tostring(sl_roe_pct, "#.#") + "% ROE", 
                                  color=#ff1744, textcolor=color.white, style=label.style_label_down, size=size.small)
                        ob.completed := true
