alertcondition(long_trigger, title="🚀 HERMES 3.5 LIMIT BUY FILLED", message="🚀 [HERMES 3.5] 5% Boundary BUY FILLED on {{ticker}}! Entry: {{close}} | TP: +14.0% ROE | SL: -14.0% ROE")
