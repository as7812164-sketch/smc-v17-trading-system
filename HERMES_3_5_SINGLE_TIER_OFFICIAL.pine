    table.cell(dash, 0, 0, "🏛️ HERMES 3.5 APEX", bgcolor=color.new(#1E293B, 10), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "RADAR HARVEST 5X", bgcolor=color.new(#1E293B, 10), text_color=#00F59B, text_size=size.small)
    
    table.cell(dash, 0, 1, "Sentry 1 (King BTC 4H)", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 1, btc_status_str, text_color=btc_is_bull ? color.green : color.red, text_size=size.tiny)
    
    table.cell(dash, 0, 2, "Entry Level (Depth)", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, "5% Boundary Rim", text_color=#F59E0B, text_size=size.tiny)
    
    table.cell(dash, 0, 3, "Proximity Radar", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 3, "0.20% Pre-Arm Buffer", text_color=#38BDF8, text_size=size.tiny)
    
    table.cell(dash, 0, 4, "Profit Harvest Lock", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 4, "+9.0% -> Lock +4.5% ROE", text_color=#00E5FF, text_size=size.tiny)
    
    table.cell(dash, 0, 5, "Target / Initial SL (5x)", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 5, "+14.0% TP / -14.0% SL", text_color=#00F59B, text_size=size.tiny)
    
    table.cell(dash, 0, 6, "Active Unmitigated Zones", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 6, str.tostring(active_unmitigated_count) + " Forward (+5 Margin)", text_color=color.white, text_size=size.tiny)

