//@version=5
indicator("HERMES 3.5 APEX — Single Tier Official Live Indicator", shorttitle="HERMES 3.5 SINGLE TIER", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==============================================================================
// 🏛️ HERMES 3.5 SINGLE TIER OFFICIAL PINE SCRIPT V5
// Exact Parity with 24/7 Autonomous Live Paper Trading System & Binance CLOB
//
// Core Strategy Specifications:
// 1. Single Tier Institutional Order Block (Displacement >= 5.0% + FVG Footprint)
// 2. Sentry 1: King BTC 4H Macro Causal Sentry (4H Trend Alignment)
// 3. Sentry 2: Institutional Floor (Displacement Wave >= 5.0% + Fair Value Gap)
// 4. Sentry 3: Inducement (IDM) Sweep + >= 18% Wick Rejection
// 5. Sentry 4: Freshness Guard (Retest tap window <= 28 bars)
// 6. Entry: Strictly at 50% Mean Threshold (MT = (OB_High + OB_Low) / 2)
// 7. Target TP: +14.00% ROE (+2.80% Price Move at 5x Leverage)
// 8. Profit Armor Stage 1: +8.00% ROE (+1.60% Price Move -> Locks Breakeven +0.10%)
// 9. Dynamic Stop Loss: -14.00% ROE (-2.80% Price Move at 5x Leverage)
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. USER INPUTS & PARAMETERS
// ------------------------------------------------------------------------------
grp_entry   = "⚙️ Hermes 3.5 Institutional Core Pillars"
min_disp    = input.float(5.0, "Min Displacement Wave (%)", minval=1.5, maxval=20.0, step=0.5, group=grp_entry)
max_bars    = input.int(28, "Sentry 4 Freshness Limit (Bars)", minval=5, maxval=100, group=grp_entry)
strict_col  = input.bool(true, "Strict Candle Color Gate (Red for Bull, Green for Bear)", group=grp_entry)
extend_box  = input.bool(true, "Extend OB Box Until 1st Tap Mitigation", group=grp_entry)

grp_sentry  = "🛡️ Sentry 1: King BTC 4H Macro Causal Sentry"
btc_filter  = input.bool(true, "Enable King BTC 4H Trend Alignment", group=grp_sentry)
btc_symbol  = input.symbol("BINANCE:BTCUSDT", "BTC Benchmark Symbol", group=grp_sentry)

grp_risk    = "💰 5x Leverage Compounding Targets (Pure Tier 1)"
leverage    = input.float(5.0, "Leverage Multiplier (x)", minval=1.0, maxval=50.0, step=1.0, group=grp_risk)
tp_roe_pct  = input.float(14.00, "Take Profit (TP) ROE %", minval=1.0, maxval=100.0, step=0.5, group=grp_risk, tooltip="+14.00% ROE at 5x = +2.80% price move")
sl_roe_pct  = input.float(14.00, "Dynamic Stop Loss (SL) ROE %", minval=1.0, maxval=100.0, step=0.5, group=grp_risk, tooltip="-14.00% ROE at 5x = -2.80% price move")
be_armor_roe= input.float(8.00, "Profit Armor Stage 1 ROE %", minval=1.0, maxval=50.0, step=0.5, group=grp_risk, tooltip="+8.00% ROE at 5x = +1.60% price move -> Locks Breakeven +0.10%")

grp_ui      = "🎨 Visual Styling & Display"
show_table  = input.bool(true, "Show Hermes 3.5 Sentries HUD Table", group=grp_ui)
show_lines  = input.bool(true, "Draw 50% MT, TP, Armor, and SL Lines", group=grp_ui)
col_bull_ob = input.color(color.new(#00F59B, 80), "Bullish Demand OB Box", group=grp_ui)
col_bear_ob = input.color(color.new(#FF3B69, 80), "Bearish Supply OB Box", group=grp_ui)
col_mt      = input.color(#F59E0B, "50% Mean Threshold Line (Amber Gold)", group=grp_ui)
col_tp      = input.color(#00F59B, "Target TP Line (+14.0% ROE)", group=grp_ui)
col_armor   = input.color(#00E5FF, "Profit Armor Line (+8.0% ROE)", group=grp_ui)
col_sl      = input.color(#FF3B69, "Dynamic Stop Loss Line (-14.0% ROE)", group=grp_ui)

// Mathematical Conversions
tp_price_pct   = (tp_roe_pct / 100.0) / leverage       // +2.80% price move
sl_price_pct   = (sl_roe_pct / 100.0) / leverage       // -2.80% price move
armor_price_pct= (be_armor_roe / 100.0) / leverage     // +1.60% price move

// ------------------------------------------------------------------------------
// 2. SENTRY 1: KING BTC 4H MACRO CAUSAL BRAKE
// ------------------------------------------------------------------------------
btc_4h_c = request.security(btc_symbol, "240", close[1], lookahead=barmerge.lookahead_off)
btc_4h_ema50 = request.security(btc_symbol, "240", ta.ema(close, 50)[1], lookahead=barmerge.lookahead_off)
btc_is_bull = btc_filter ? (btc_4h_c >= btc_4h_ema50) : true
btc_is_bear = btc_filter ? (btc_4h_c <= btc_4h_ema50) : true
btc_status_str = btc_is_bull ? "🟢 BTC > EMA50 (BULLISH)" : "🔴 BTC < EMA50 (BEARISH)"

// ------------------------------------------------------------------------------
// 3. SENTRY 2: DISPLACEMENT & FVG FOOTPRINT QUALIFICATION
// ------------------------------------------------------------------------------
c3_open  = open[3]
c3_high  = high[3]
c3_low   = low[3]
c3_close = close[3]

c2_high  = high[2]
c2_low   = low[2]

c1_high  = high[1]
c1_low   = low[1]

impulse_high = math.max(c1_high, c2_high)
impulse_low  = math.min(c1_low, c2_low)

bull_fvg = (c1_low > c3_high)
bear_fvg = (c1_high < c3_low)

bull_disp_pct = ((impulse_high - c3_low) / c3_low) * 100.0
bear_disp_pct = ((c3_high - impulse_low) / c3_high) * 100.0

bull_color_ok = not strict_col or (c3_close < c3_open)
bear_color_ok = not strict_col or (c3_close > c3_open)

bull_ob_qual = bull_color_ok and bull_fvg and (bull_disp_pct >= min_disp) and btc_is_bull
bear_ob_qual = bear_color_ok and bear_fvg and (bear_disp_pct >= min_disp) and btc_is_bear

// ------------------------------------------------------------------------------
// 4. DATA TYPES & UNMITIGATED ACTIVE ZONES STORAGE
// ------------------------------------------------------------------------------
type HermesZone
    bool is_bull
    int start_bar
    float ob_high
    float ob_low
    float mt
    float tp_p
    float armor_p
    float sl_p
    box ob_box
    line mt_line
    line tp_line
    line armor_line
    line sl_line
    bool tapped
    bool armor_locked
    bool completed

var HermesZone[] zones = array.new<HermesZone>()

// Register New Institutional Order Block at bar [3]
if bull_ob_qual
    float o_high = c3_high
    float o_low  = c3_low
    float mt     = (o_high + o_low) / 2.0
    float tp     = mt * (1.0 + tp_price_pct)
    float armor  = mt * (1.0 + armor_price_pct)
    float sl     = mt * (1.0 - sl_price_pct)
    int s_bar    = bar_index - 3

    box b = box.new(s_bar, o_high, bar_index + 2, o_low, border_color=color.new(#00F59B, 20), border_width=1, bgcolor=col_bull_ob)
    line l_mt = line.new(s_bar, mt, bar_index + 2, mt, color=col_mt, width=1, style=line.style_dashed)
    
    HermesZone nz = HermesZone.new(true, s_bar, o_high, o_low, mt, tp, armor, sl, b, l_mt, na, na, na, false, false, false)
    array.push(zones, nz)

if bear_ob_qual
    float o_high = c3_high
    float o_low  = c3_low
    float mt     = (o_high + o_low) / 2.0
    float tp     = mt * (1.0 - tp_price_pct)
    float armor  = mt * (1.0 - armor_price_pct)
    float sl     = mt * (1.0 + sl_price_pct)
    int s_bar    = bar_index - 3

    box b = box.new(s_bar, o_high, bar_index + 2, o_low, border_color=color.new(#FF3B69, 20), border_width=1, bgcolor=col_bear_ob)
    line l_mt = line.new(s_bar, mt, bar_index + 2, mt, color=col_mt, width=1, style=line.style_dashed)
    
    HermesZone nz = HermesZone.new(false, s_bar, o_high, o_low, mt, tp, armor, sl, b, l_mt, na, na, na, false, false, false)
    array.push(zones, nz)

// ------------------------------------------------------------------------------
// 5. 50% MEAN THRESHOLD TAP TRIGGER & SENTRY 3 AUDIT
// ------------------------------------------------------------------------------
bool long_trigger  = false
bool short_trigger = false
float trigger_entry = 0.0
candle_range = high - low

if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        HermesZone z = array.get(zones, i)
        
        if not z.completed
            // Dynamic Box Extension
            if extend_box and not z.tapped
                box.set_right(z.ob_box, bar_index + 2)
                line.set_x2(z.mt_line, bar_index + 2)
                
            // Check 1st Tap Mitigation
            if not z.tapped
                int bars_alive = bar_index - z.start_bar
                if bars_alive > max_bars
                    z.completed := true
                else if z.is_bull
                    // Invalidation: candle body closes below OB Low
                    if close < z.ob_low
                        z.completed := true
                    else
                        // 50% Mean Threshold Tap Condition
                        bool tapped_mt = (low <= z.mt) and (low >= z.sl_p)
                        if tapped_mt
                            // Sentry 3: IDM Sweep + >= 18% Lower Wick Rejection
                            float l_wick = math.min(open, close) - low
                            float wick_ratio = candle_range > 0 ? (l_wick / candle_range) * 100.0 : 0.0
                            bool idm_swept = (low < ta.lowest(low[1], 5))
                            bool wick_pass = (wick_ratio >= 18.0) and (close >= z.mt)
                            
                            if wick_pass or idm_swept
                                z.tapped := true
                                trigger_entry := z.mt
                                long_trigger := true
                                box.set_right(z.ob_box, bar_index)
                                line.set_x2(z.mt_line, bar_index)
                                
                                if show_lines
                                    z.tp_line    := line.new(bar_index, z.tp_p, bar_index + 20, z.tp_p, color=col_tp, width=2, style=line.style_solid)
                                    z.armor_line := line.new(bar_index, z.armor_p, bar_index + 20, z.armor_p, color=col_armor, width=1, style=line.style_dashed)
                                    z.sl_line    := line.new(bar_index, z.sl_p, bar_index + 20, z.sl_p, color=col_sl, width=1, style=line.style_dashed)
                                    
                                label.new(bar_index, low, "⚡ H3.5 BUY\n50% MT: $" + str.tostring(z.mt, "#.####") + "\nTP: +14% ROE", color=color.new(#00F59B, 10), textcolor=color.black, style=label.style_label_up, size=size.small)
                                alert("HERMES 3.5 50% MT BUY TRIGGERED on " + syminfo.ticker + " at $" + str.tostring(z.mt), alert.freq_once_per_bar_close)
                else
                    if close > z.ob_high
                        z.completed := true
                    else
                        bool tapped_mt = (high >= z.mt) and (high <= z.sl_p)
                        if tapped_mt
                            float u_wick = high - math.max(open, close)
                            float wick_ratio = candle_range > 0 ? (u_wick / candle_range) * 100.0 : 0.0
                            bool idm_swept = (high > ta.highest(high[1], 5))
                            bool wick_pass = (wick_ratio >= 18.0) and (close <= z.mt)
                            
                            if wick_pass or idm_swept
                                z.tapped := true
                                trigger_entry := z.mt
                                short_trigger := true
                                box.set_right(z.ob_box, bar_index)
                                line.set_x2(z.mt_line, bar_index)
                                
                                if show_lines
                                    z.tp_line    := line.new(bar_index, z.tp_p, bar_index + 20, z.tp_p, color=col_tp, width=2, style=line.style_solid)
                                    z.armor_line := line.new(bar_index, z.armor_p, bar_index + 20, z.armor_p, color=col_armor, width=1, style=line.style_dashed)
                                    z.sl_line    := line.new(bar_index, z.sl_p, bar_index + 20, z.sl_p, color=col_sl, width=1, style=line.style_dashed)
                                    
                                label.new(bar_index, high, "⚡ H3.5 SELL\n50% MT: $" + str.tostring(z.mt, "#.####") + "\nTP: +14% ROE", color=color.new(#FF3B69, 10), textcolor=color.white, style=label.style_label_down, size=size.small)
                                alert("HERMES 3.5 50% MT SELL TRIGGERED on " + syminfo.ticker + " at $" + str.tostring(z.mt), alert.freq_once_per_bar_close)

            // Monitor Active Trade: Armor Lock & TP/SL Outcomes
            else
                if not na(z.tp_line)
                    line.set_x2(z.tp_line, bar_index)
                if not na(z.armor_line)
                    line.set_x2(z.armor_line, bar_index)
                if not na(z.sl_line)
                    line.set_x2(z.sl_line, bar_index)

                if z.is_bull
                    // Profit Armor Stage 1 Trigger (+8.0% ROE -> BE Lock +0.10%)
                    if not z.armor_locked and high >= z.armor_p
                        z.armor_locked := true
                        float be_price = z.mt * 1.0010
                        z.sl_p := be_price
                        if not na(z.sl_line)
                            line.set_y1(z.sl_line, be_price)
                            line.set_y2(z.sl_line, be_price)
                            line.set_color(z.sl_line, col_armor)
                        label.new(bar_index, low, "🛡️ ARMOR LOCK (+8% ROE)\nBE Secured (+0.1%)", color=color.new(#00E5FF, 15), textcolor=color.black, style=label.style_label_up, size=size.tiny)
                        alert("HERMES 3.5 Profit Armor Locked at Break-Even (+0.1% buffer) on " + syminfo.ticker, alert.freq_once_per_bar_close)

                    // TP Outcome
                    if high >= z.tp_p
                        label.new(bar_index, high, "🎯 TP HIT! +14.0% ROE\n100% Compounded", color=#00F59B, textcolor=color.black, style=label.style_label_down, size=size.small)
                        z.completed := true
                        alert("HERMES 3.5 TAKE PROFIT HIT (+14.0% ROE) on " + syminfo.ticker, alert.freq_once_per_bar_close)
                    else if low <= z.sl_p
                        if z.armor_locked
                            label.new(bar_index, low, "🛡️ BE EXIT (+0.1%)\nCapital Protected", color=color.new(#00E5FF, 20), textcolor=color.white, style=label.style_label_up, size=size.tiny)
                        else
                            label.new(bar_index, low, "🛑 SL HIT (-14.0% ROE)", color=#FF3B69, textcolor=color.white, style=label.style_label_up, size=size.tiny)
                        z.completed := true

                else
                    // Bearish Trade Monitor
                    if not z.armor_locked and low <= z.armor_p
                        z.armor_locked := true
                        float be_price = z.mt * 0.9990
                        z.sl_p := be_price
                        if not na(z.sl_line)
                            line.set_y1(z.sl_line, be_price)
                            line.set_y2(z.sl_line, be_price)
                            line.set_color(z.sl_line, col_armor)
                        label.new(bar_index, high, "🛡️ ARMOR LOCK (+8% ROE)\nBE Secured (+0.1%)", color=color.new(#00E5FF, 15), textcolor=color.black, style=label.style_label_down, size=size.tiny)
                        alert("HERMES 3.5 Profit Armor Locked at Break-Even (+0.1% buffer) on " + syminfo.ticker, alert.freq_once_per_bar_close)

                    if low <= z.tp_p
                        label.new(bar_index, low, "🎯 TP HIT! +14.0% ROE\n100% Compounded", color=#00F59B, textcolor=color.black, style=label.style_label_up, size=size.small)
                        z.completed := true
                        alert("HERMES 3.5 TAKE PROFIT HIT (+14.0% ROE) on " + syminfo.ticker, alert.freq_once_per_bar_close)
                    else if high >= z.sl_p
                        if z.armor_locked
                            label.new(bar_index, high, "🛡️ BE EXIT (+0.1%)\nCapital Protected", color=color.new(#00E5FF, 20), textcolor=color.white, style=label.style_label_down, size=size.tiny)
                        else
                            label.new(bar_index, high, "🛑 SL HIT (-14.0% ROE)", color=#FF3B69, textcolor=color.white, style=label.style_label_up, size=size.tiny)
                        z.completed := true

// ------------------------------------------------------------------------------
// 6. ON-CHART HUD DASHBOARD
// ------------------------------------------------------------------------------
var table dash = table.new(position.top_right, 2, 6, bgcolor=color.new(#0B0E14, 15), border_color=color.new(#374151, 50), border_width=1)

if show_table and barstate.islast
    table.cell(dash, 0, 0, "🏛️ HERMES 3.5 APEX", bgcolor=color.new(#1E293B, 10), text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, "SINGLE TIER 5X", bgcolor=color.new(#1E293B, 10), text_color=#00F59B, text_size=size.small)
    
    table.cell(dash, 0, 1, "Sentry 1 (King BTC 4H)", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 1, btc_status_str, text_color=btc_is_bull ? color.green : color.red, text_size=size.tiny)
    
    table.cell(dash, 0, 2, "Sentry 2 (Displacement)", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 2, ">= " + str.tostring(min_disp, "#.#") + "% + FVG Active", text_color=#38BDF8, text_size=size.tiny)
    
    table.cell(dash, 0, 3, "Sentry 3 (Entry Level)", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 3, "50% Mean Threshold (MT)", text_color=color.yellow, text_size=size.tiny)
    
    table.cell(dash, 0, 4, "Target / SL (5x)", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 4, "+14.0% TP / -14.0% SL", text_color=#00F59B, text_size=size.tiny)
    
    table.cell(dash, 0, 5, "Profit Armor Stage 1", text_color=color.white, text_size=size.tiny)
    table.cell(dash, 1, 5, "+8.0% ROE -> BE Lock +0.1%", text_color=#00E5FF, text_size=size.tiny)

// ------------------------------------------------------------------------------
// 7. TRADINGVIEW REAL-TIME ALERTS
// ------------------------------------------------------------------------------
alertcondition(long_trigger, title="HERMES 3.5 50% MT BUY", message="⚡ [HERMES 3.5] 50% MT BUY TRIGGERED on {{ticker}}! Entry: {{close}} | TP: +14.0% ROE | SL: -14.0% ROE")
alertcondition(short_trigger, title="HERMES 3.5 50% MT SELL", message="⚡ [HERMES 3.5] 50% MT SELL TRIGGERED on {{ticker}}! Entry: {{close}} | TP: +14.0% ROE | SL: -14.0% ROE")
