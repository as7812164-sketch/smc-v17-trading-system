//@version=5
indicator("HERMES 15-PILLAR INSTITUTIONAL MASTER INDICATOR", "🏛️ HERMES 15-PILLAR MASTER", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ─── 1. INPUT SETTINGS & MODULAR TOGGLES (EPISODES 01–15) ───────────────────
// Master HUD
grp_hud           = "═══ 0. Master Institutional HUD Dashboard ═══"
showHUD           = input.bool(true, "Display Institutional Real-Time HUD Table", group=grp_hud)

// Ep 15: 7-Condition Order Block Classifier
grp_ep15          = "═══ Episode 15: Advanced 7-Condition Order Block Classifier ═══"
enableOBClassifier   = input.bool(true, "Enable 7-Condition Order Block Engine", group=grp_ep15)
showWeakOBTraps      = input.bool(true, "Highlight Weak OBs as Inducement / Liquidity Traps", group=grp_ep15)
enforceCondMSSGate   = input.bool(true, "Enforce Mandatory 5m MSS Sentry for Conditional OBs", group=grp_ep15)
colStrongestOB       = input.color(color.new(#00E676, 75), "Strongest Conditional OB Color (Emerald)", group=grp_ep15)
colStrongestOBBorder = input.color(#00E676, "Strongest Conditional OB Border", group=grp_ep15)
colStrongOB          = input.color(color.new(#1E88E5, 75), "Strong Order Block Color (Blue)", group=grp_ep15)
colStrongOBBorder    = input.color(#1E88E5, "Strong Order Block Border", group=grp_ep15)
colConditionalOB     = input.color(color.new(#FFB300, 75), "Conditional Order Block Color (Amber)", group=grp_ep15)
colCondOBBorder      = input.color(#FFB300, "Conditional Order Block Border", group=grp_ep15)
colWeakOBTrap        = input.color(color.new(#D32F2F, 80), "Weak OB / IDM Trap Color (Crimson)", group=grp_ep15)
colWeakOBBorder      = input.color(#D32F2F, "Weak OB / IDM Trap Border", group=grp_ep15)

// Ep 14: CBDR Engine
grp_ep14          = "═══ Episode 14: CBDR Day High/Low Predictor Engine ═══"
enableCBDR        = input.bool(true, "Enable CBDR Day High/Low Predictor Engine", group=grp_ep14)
showCBDRBox       = input.bool(true, "Show CBDR Body Box (14:00 - 20:00 NY)", group=grp_ep14)
showCBDR_SDs      = input.bool(true, "Show Standard Deviations (SD ±1, ±2, ±3, ±4)", group=grp_ep14)
cbdrMaxPipFilter  = input.float(220.0, "Max CBDR Range Filter (Pips) - Abort if Exceeded", minval=50.0, maxval=500.0, step=10.0, group=grp_ep14)
cbdrIdealMinPips  = input.float(100.0, "Ideal CBDR Min Pips (Gold Benchmark)", minval=20.0, maxval=200.0, step=10.0, group=grp_ep14)
cbdrIdealMaxPips  = input.float(150.0, "Ideal CBDR Max Pips (Gold Benchmark)", minval=50.0, maxval=300.0, step=10.0, group=grp_ep14)
colCBDRBox        = input.color(color.new(#7E57C2, 85), "CBDR Box Background Color", group=grp_ep14)
colCBDRBorder     = input.color(#7E57C2, "CBDR Border Color", group=grp_ep14)
colSD_DayLow      = input.color(#00E676, "Bullish Day Low SD Lines (-1, -2)", group=grp_ep14)
colSD_DayHigh     = input.color(#FF1744, "Bearish Day High SD Lines (+1, +2)", group=grp_ep14)

// Ep 13: Bias Mastery & Exhaustion
grp_ep13          = "═══ Episode 13: Bias Mastery, IDM vs MSS & ATH Exhaustion ═══"
showATHExhaustion = input.bool(true, "Detect 3-Candle Exhaustion Top at ATH / Swing Extremes", group=grp_ep13)
showIDMvsMSS      = input.bool(true, "Show IDM (Continuation) vs MSS (Reversal) Badges", group=grp_ep13)
enforceHeavyTruck = input.bool(true, "Enforce Heavy Truck HTF Bias Dominance", group=grp_ep13)

// Ep 11 & 12: Killzones & Session Models
grp_kz            = "═══ Episodes 11 & 12: ICT Killzones & Session Models ═══"
enableKillzones   = input.bool(true, "Enable ICT Killzones & Sessions", group=grp_kz)
isSummerNY        = input.bool(true, "Summer Time (UTC-4 NY) / False=Winter (UTC-5)", group=grp_kz)
showSessionBoxes  = input.bool(true, "Colorize Active Killzones", group=grp_kz)
colAsianSession   = input.color(color.new(#2962FF, 90), "Asian Killzone Tint (20:00-00:00)", group=grp_kz)
colLondonSession  = input.color(color.new(#FF6D00, 90), "London Killzone Tint (02:00-05:00)", group=grp_kz)
colNYSession      = input.color(color.new(#00C853, 90), "New York Killzone Tint (07:00-10:00)", group=grp_kz)
colLondonClose    = input.color(color.new(#AA00FF, 92), "London Close Tint (10:00-12:00)", group=grp_kz)
enablePreAsian    = input.bool(true, "Enable Pre-Asian 1:3 Funded Strategy", group=grp_kz)
colPreAsian       = input.color(color.new(#E040FB, 92), "Pre-Asian Window Tint (15:30-20:00)", group=grp_kz)
enableLondonStrat = input.bool(true, "Enable London Asian-Purge Strategy", group=grp_kz)
enableNYStrat     = input.bool(true, "Enable NY Continuation & Judas Reversal", group=grp_kz)
enforceDeadZone   = input.bool(true, "Strict Dead-Zone Trading Ban", group=grp_kz)

// Ep 10: OTE & Inside Bar
grp_ep10          = "═══ Episode 10: Optimal Trade Entry (OTE) & Inside Bars ═══"
showOTEZone       = input.bool(true, "Show OTE Golden Zone (0.618 - 0.790)", group=grp_ep10)
oteFib0618        = input.float(0.618, "OTE Upper Bound Level", group=grp_ep10)
oteFib0790        = input.float(0.790, "OTE Lower Bound Level", group=grp_ep10)
colOTEZone        = input.color(color.new(#FFD700, 80), "OTE Golden Zone Tint", group=grp_ep10)
colOTELine        = input.color(#FFB300, "OTE Boundary Lines", group=grp_ep10)
highlightInsideBars = input.bool(true, "Highlight Inside Bar Candles", group=grp_ep10)
colInsideBar      = input.color(color.new(#9C27B0, 60), "Inside Bar Color", group=grp_ep10)

// Ep 09: Valuation & Dynamic Profit Armor
grp_ep09          = "═══ Episode 09: Valuation & Dynamic Profit Armor ═══"
showPremDiscZones = input.bool(true, "Show Premium & Discount Zones (0 / 0.5 / 1.0)", group=grp_ep09)
enforceValuation  = input.bool(true, "Strict Valuation Gate (Buy Discount / Sell Premium Only)", group=grp_ep09)
allowLRL_Bypass   = input.bool(false, "Allow Equilibrium Bypass on High Momentum LRL Runs", group=grp_ep09)
accountCapital    = input.float(100.0, "Account Capital ($) for Dynamic Lot Calculator", minval=10.0, step=10.0, group=grp_ep09)
riskPctPerTrade   = input.float(2.8, "Risk Per Trade (%)", minval=1.0, maxval=5.0, step=0.1, group=grp_ep09)
targetRR          = input.float(2.8, "Target Take Profit (1:X)", minval=1.5, maxval=10.0, step=0.1, group=grp_ep09)
beTriggerRR       = input.float(1.0, "Fast Breakeven Trigger Ratio (+1.0%)", minval=0.5, maxval=2.0, step=0.1, group=grp_ep09)

// Ep 08: Entry Models & Confirmation
grp_ep08          = "═══ Episode 08: Master Entry Confirmation Engine ═══"
entryMode         = input.string("All Models (Universal)", "Active Entry Model Filter", options=["All Models (Universal)", "Model 1: Standard MSS Retest", "Model 2: Aggressive No-MSS", "Model 3: LRL Fast Execution", "Model 4: Safest 2nd BOS", "Model 5: Sweep Turtle Soup"], group=grp_ep08)
displacementMult  = input.float(1.2, "Displacement Candle Body / ATR Multiplier", minval=0.8, maxval=3.0, step=0.1, group=grp_ep08)
allowWickMSS      = input.bool(true, "Allow Wick-Only Break for LTF MSS", group=grp_ep08)

// Ep 01–07: Core Structure, Gaps, Liquidity
grp_core          = "═══ Episodes 01–07: Structure, Liquidity & Gaps ═══"
swingLookback     = input.int(5, "LTF Local Swing Lookback", minval=2, maxval=20, group=grp_core)
showFVG           = input.bool(true, "Show Fair Value Gaps (FVG)", group=grp_core)
showLRL_Voids     = input.bool(true, "Show LRL Liquidity Voids", group=grp_core)
showDailyBias     = input.bool(true, "Track Daily Candle Liquidity (PDH/PDL)", group=grp_core)
showAsianSession  = input.bool(true, "Track Asian Session High/Low & Sweeps", group=grp_core)
showEQH_EQL       = input.bool(true, "Show Equal Highs/Lows (EQH/EQL $$$)", group=grp_core)
eqToleranceATR    = input.float(0.15, "EQH/EQL ATR Proximity Ratio", minval=0.05, maxval=0.5, step=0.05, group=grp_core)
colPremium        = input.color(#FF1744, "Premium Zone Color", group=grp_core)
colDiscount       = input.color(#00E676, "Discount Zone Color", group=grp_core)
colEquilibrium    = input.color(#FFFFFF, "0.5 Equilibrium Line Color", group=grp_core)
colFVG            = input.color(#FFE57F, "Fair Value Gap Color", group=grp_core)
colBuySignal      = input.color(#00E676, "Hermes Institutional Long Color", group=grp_core)
colSellSignal     = input.color(#FF1744, "Hermes Institutional Short Color", group=grp_core)

// ─── 2. ROBUST ZERO-CRASH STATE CONTAINERS ──────────────────────────────────
var float latestBullFVG_Top       = na
var float latestBullFVG_Bottom    = na
var bool  latestBullFVG_Mitigated = false

var float latestBearFVG_Top       = na
var float latestBearFVG_Bottom    = na
var bool  latestBearFVG_Mitigated = false

string nyTz = isSummerNY ? "UTC-4" : "UTC-5"
float atrVal = ta.atr(14)
float candleBody = math.abs(close - open)

// Inside Bar Detection (Ep 10)
bool isInsideBar = (high <= high[1]) and (low >= low[1])
barcolor(highlightInsideBars and isInsideBar ? colInsideBar : na)

// ─── 3. DAILY BIAS & TIME-BASED LIQUIDITY (EP 07, 11, 13) ───────────────────
[pdh, pdl, pdc, pdo] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1], open[1]], lookahead=barmerge.lookahead_on)

var line pdhLine = na
var line pdlLine = na
var string dailyBiasState = "NEUTRAL"

if showDailyBias and barstate.islast
    line.delete(pdhLine)
    line.delete(pdlLine)
    pdhLine := line.new(bar_index - 30, pdh, bar_index + 10, pdh, color=color.new(colPremium, 30), width=2, style=line.style_dashed)
    pdlLine := line.new(bar_index - 30, pdl, bar_index + 10, pdl, color=color.new(colDiscount, 30), width=2, style=line.style_dashed)

bool pdhSwept = (high > pdh) and (close < pdh)
bool pdhRun   = (close > pdh)
bool pdlSwept = (low < pdl) and (close > pdl)
bool pdlRun   = (close < pdl)

if pdhSwept
    dailyBiasState := "BEARISH REVERSAL (PDH Swept)"
else if pdhRun
    dailyBiasState := "BULLISH RUN (PDH Expansion)"
else if pdlSwept
    dailyBiasState := "BULLISH REVERSAL (PDL Swept)"
else if pdlRun
    dailyBiasState := "BEARISH RUN (PDL Expansion)"

bool isBullishDayBias = (dailyBiasState == "BULLISH RUN (PDH Expansion)") or (dailyBiasState == "BULLISH REVERSAL (PDL Swept)") or (close > pdc)

// Asian Session Tracking (Ep 07 & 11)
bool inAsianSession = not na(time(timeframe.period, "0000-0800:1234567"))
var float asianHigh = na
var float asianLow  = na
var bool  asianHighSwept = false
var bool  asianLowSwept  = false

if inAsianSession
    if na(asianHigh) or high > asianHigh
        asianHigh := high
    if na(asianLow) or low < asianLow
        asianLow  := low
    asianHighSwept := false
    asianLowSwept  := false
else
    if not na(asianHigh) and (high > asianHigh) and (close < asianHigh) and not asianHighSwept and showAsianSession
        asianHighSwept := true
        label.new(bar_index, high, "⚡ ASIAN HIGH SWEPT!\n[London Judas Swing]", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.small)
    if not na(asianLow) and (low < asianLow) and (close > asianLow) and not asianLowSwept and showAsianSession
        asianLowSwept := true
        label.new(bar_index, low, "⚡ ASIAN LOW SWEPT!\n[London Judas Swing]", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.small)

// ─── 4. STRUCTURE MAPPING, PULLBACK & FVG ENGINE (EP 01–05) ─────────────────
float pHigh = ta.pivothigh(high, swingLookback, swingLookback)
float pLow  = ta.pivotlow(low, swingLookback, swingLookback)

var float activeSwingHigh = na
var float activeSwingLow  = na
var int   activeHighBar   = na
var int   activeLowBar    = na

if not na(pHigh)
    activeSwingHigh := pHigh
    activeHighBar   := bar_index - swingLookback

if not na(pLow)
    activeSwingLow  := pLow
    activeLowBar    := bar_index - swingLookback

// FVG Imbalances
bool isBullFVG = (low[0] > high[2])
bool isBearFVG = (high[0] < low[2])

if isBullFVG
    if showFVG
        box.new(bar_index - 2, low[0], bar_index, high[2], border_color=color.new(colFVG, 40), bgcolor=color.new(colFVG, 85))
    latestBullFVG_Top       := low[0]
    latestBullFVG_Bottom    := high[2]
    latestBullFVG_Mitigated := false

if isBearFVG
    if showFVG
        box.new(bar_index - 2, low[2], bar_index, high[0], border_color=color.new(colFVG, 40), bgcolor=color.new(colFVG, 85))
    latestBearFVG_Top       := high[0]
    latestBearFVG_Bottom    := low[2]
    latestBearFVG_Mitigated := false

// ─── 5. PREMIUM/DISCOUNT & OTE GOLDEN ZONE (EP 09 & 10) ─────────────────────
float equilibrium05 = (not na(activeSwingHigh) and not na(activeSwingLow)) ? (activeSwingHigh + activeSwingLow) / 2.0 : na
bool  isInDiscount  = not na(equilibrium05) and (close <= equilibrium05)
bool  isInPremium   = not na(equilibrium05) and (close >= equilibrium05)

var box  premiumBox = na
var box  discountBox = na
var line eqLine     = na

if showPremDiscZones and not na(activeSwingHigh) and not na(activeSwingLow) and barstate.islast
    box.delete(premiumBox)
    box.delete(discountBox)
    line.delete(eqLine)
    int startB = math.min(nz(activeHighBar, bar_index - 20), nz(activeLowBar, bar_index - 20))
    premiumBox  := box.new(startB, activeSwingHigh, bar_index + 15, equilibrium05, border_color=color.new(colPremium, 50), bgcolor=color.new(colPremium, 90))
    discountBox := box.new(startB, equilibrium05, bar_index + 15, activeSwingLow, border_color=color.new(colDiscount, 50), bgcolor=color.new(colDiscount, 90))
    eqLine      := line.new(startB, equilibrium05, bar_index + 15, equilibrium05, color=colEquilibrium, width=2, style=line.style_dashed)

// OTE Golden Zone
float swRange = (not na(activeSwingHigh) and not na(activeSwingLow)) ? (activeSwingHigh - activeSwingLow) : na
float bullOTE0618 = not na(swRange) ? (activeSwingHigh - (oteFib0618 * swRange)) : na
float bullOTE0790 = not na(swRange) ? (activeSwingHigh - (oteFib0790 * swRange)) : na
float bearOTE0618 = not na(swRange) ? (activeSwingLow + (oteFib0618 * swRange)) : na
float bearOTE0790 = not na(swRange) ? (activeSwingLow + (oteFib0790 * swRange)) : na

bool inBullOTE = not na(bullOTE0618) and not na(bullOTE0790) and (low <= bullOTE0618) and (high >= bullOTE0790)
bool inBearOTE = not na(bearOTE0618) and not na(bearOTE0790) and (high >= bearOTE0618) and (low <= bearOTE0790)

var box oteBox = na
if showOTEZone and not na(activeSwingHigh) and not na(activeSwingLow) and barstate.islast
    box.delete(oteBox)
    int oteStartB = math.min(nz(activeHighBar, bar_index - 20), nz(activeLowBar, bar_index - 20))
    float oteTop = isInPremium ? bearOTE0790 : bullOTE0618
    float oteBot = isInPremium ? bearOTE0618 : bullOTE0790
    oteBox := box.new(oteStartB, oteTop, bar_index + 20, oteBot, border_color=colOTELine, bgcolor=colOTEZone)

// ─── 6. DISPLACEMENT & MSS DETECTION ENGINE (EP 08) ─────────────────────────
bool isBullDisp = (close > open) and (candleBody >= (atrVal * displacementMult)) and isBullFVG
bool isBearDisp = (close < open) and (candleBody >= (atrVal * displacementMult)) and isBearFVG

bool bullMSS_Trigger = false
bool bearMSS_Trigger = false

if not na(activeSwingHigh)
    bool highPierced = allowWickMSS ? (high > activeSwingHigh) : (close > activeSwingHigh)
    if highPierced and isBullDisp
        bullMSS_Trigger := true

if not na(activeSwingLow)
    bool lowPierced = allowWickMSS ? (low < activeSwingLow) : (close < activeSwingLow)
    if lowPierced and isBearDisp
        bearMSS_Trigger := true

var string currentMSSState   = "NONE"
var float  lastBullMSS_Level = na
var float  lastBearMSS_Level = na
var int    lastBullMSS_Bar   = na
var int    lastBearMSS_Bar   = na

if bullMSS_Trigger
    currentMSSState    := "BULLISH MSS CONFIRMED"
    lastBullMSS_Level  := activeSwingHigh
    lastBullMSS_Bar    := bar_index
    label.new(bar_index, activeSwingHigh, "⚡ BULLISH MSS\n[Displacement Pierced]", color=colBuySignal, textcolor=color.black, style=label.style_label_down, size=size.small)

if bearMSS_Trigger
    currentMSSState    := "BEARISH MSS CONFIRMED"
    lastBearMSS_Level  := activeSwingLow
    lastBearMSS_Bar    := bar_index
    label.new(bar_index, activeSwingLow, "⚡ BEARISH MSS\n[Displacement Pierced]", color=colSellSignal, textcolor=color.white, style=label.style_label_up, size=size.small)

// ─── 7. 7-CONDITION ORDER BLOCK CLASSIFIER & WEAK OB TRAP (EP 15) ───────────
bool isOBBullDisp = (close > high[2]) and (low > high[2])
bool isOBBearDisp = (close < low[2]) and (high < low[2])

var box    lastStrongestOBBox = na
var box    lastStrongOBBox    = na
var box    lastCondOBBox      = na
var box    lastWeakOBBox      = na
var float  lastActiveOBLow    = na
var float  lastActiveOBHigh   = na
var bool   isLastOBBullish    = na
var string currentOBQuality   = "SEARCHING"

bool priorSwingLowSwept  = (ta.lowest(low, 5)[2] < ta.lowest(low, 20)[7]) and (ta.lowest(close, 5)[2] > ta.lowest(low, 20)[7])
bool priorSwingHighSwept = (ta.highest(high, 5)[2] > ta.highest(high, 20)[7]) and (ta.highest(close, 5)[2] < ta.highest(high, 20)[7])

if enableOBClassifier
    // Bullish OB
    if isOBBullDisp
        bool t1SameColor   = (close[2] > open[2])
        bool t2OppColor    = (close[2] <= open[2])
        bool t3BreachedExt = (low[1] < low[2])
        bool t4SwingExt    = (low[2] <= ta.lowest(low, 15)[1])
        bool cond1Sweep    = priorSwingLowSwept
        bool cond2IDMSweep = not na(lastActiveOBLow) and (low[1] < lastActiveOBLow or low[2] < lastActiveOBLow) and str.contains(currentOBQuality, "WEAK")

        lastActiveOBLow  := low[2]
        lastActiveOBHigh := high[2]
        isLastOBBullish  := true

        if cond1Sweep or cond2IDMSweep
            currentOBQuality := "⚡ STRONGEST CONDITIONAL OB"
            box.delete(lastStrongestOBBox)
            lastStrongestOBBox := box.new(bar_index - 2, high[2], bar_index + 20, low[2], bgcolor=colStrongestOB, border_color=colStrongestOBBorder, border_width=2)
            label.new(bar_index - 2, low[2], "⚡ STRONGEST OB\n[Post-Sweep / IDM Purged]\nColor Ignored - Sniper Limit Entry!", color=#00E676, textcolor=color.black, style=label.style_label_up, size=size.small)
        else if t2OppColor and t4SwingExt and not t3BreachedExt
            currentOBQuality := "🏛️ STRONG BULLISH OB"
            box.delete(lastStrongOBBox)
            lastStrongOBBox := box.new(bar_index - 2, high[2], bar_index + 20, low[2], bgcolor=colStrongOB, border_color=colStrongOBBorder, border_width=2)
            label.new(bar_index - 2, low[2], "🏛️ STRONG BULLISH OB\n[Red Candle + Swing Low]\nDirect Limit Allowed", color=#1E88E5, textcolor=color.white, style=label.style_label_up, size=size.small)
        else if isInDiscount
            currentOBQuality := "⏳ CONDITIONAL BULLISH OB"
            box.delete(lastCondOBBox)
            lastCondOBBox := box.new(bar_index - 2, high[2], bar_index + 20, low[2], bgcolor=colConditionalOB, border_color=colCondOBBorder, border_width=1, border_style=line.style_dashed)
        else if showWeakOBTraps
            currentOBQuality := "🚨 WEAK OB (LIQUIDITY TRAP / IDM)"
            box.delete(lastWeakOBBox)
            lastWeakOBBox := box.new(bar_index - 2, high[2], bar_index + 20, low[2], bgcolor=colWeakOBTrap, border_color=colWeakOBBorder, border_width=1, border_style=line.style_dotted)
            label.new(bar_index - 2, low[2], "🚨 WEAK OB TRAP\n[Inducement Fuel]\nDO NOT BUY - TARGET AS LIQUIDITY!", color=#D32F2F, textcolor=color.white, style=label.style_label_up, size=size.tiny)

    // Bearish OB
    if isOBBearDisp
        bool t1SameColorBear   = (close[2] < open[2])
        bool t2OppColorBear    = (close[2] >= open[2])
        bool t3BreachedExtBear = (high[1] > high[2])
        bool t4SwingExtBear    = (high[2] >= ta.highest(high, 15)[1])
        bool cond1SweepBear    = priorSwingHighSwept
        bool cond2IDMSweepBear = not na(lastActiveOBHigh) and (high[1] > lastActiveOBHigh or high[2] > lastActiveOBHigh) and str.contains(currentOBQuality, "WEAK")

        lastActiveOBLow  := low[2]
        lastActiveOBHigh := high[2]
        isLastOBBullish  := false

        if cond1SweepBear or cond2IDMSweepBear
            currentOBQuality := "⚡ STRONGEST CONDITIONAL OB"
            box.delete(lastStrongestOBBox)
            lastStrongestOBBox := box.new(bar_index - 2, high[2], bar_index + 20, low[2], bgcolor=colStrongestOB, border_color=colStrongestOBBorder, border_width=2)
            label.new(bar_index - 2, high[2], "⚡ STRONGEST OB\n[Post-Sweep / IDM Purged]\nColor Ignored - Sniper Limit Entry!", color=#00E676, textcolor=color.black, style=label.style_label_down, size=size.small)
        else if t2OppColorBear and t4SwingExtBear and not t3BreachedExtBear
            currentOBQuality := "🏛️ STRONG BEARISH OB"
            box.delete(lastStrongOBBox)
            lastStrongOBBox := box.new(bar_index - 2, high[2], bar_index + 20, low[2], bgcolor=colStrongOB, border_color=colStrongOBBorder, border_width=2)
            label.new(bar_index - 2, high[2], "🏛️ STRONG BEARISH OB\n[Green Candle + Swing High]\nDirect Limit Allowed", color=#1E88E5, textcolor=color.white, style=label.style_label_down, size=size.small)
        else if isInPremium
            currentOBQuality := "⏳ CONDITIONAL BEARISH OB"
            box.delete(lastCondOBBox)
            lastCondOBBox := box.new(bar_index - 2, high[2], bar_index + 20, low[2], bgcolor=colConditionalOB, border_color=colCondOBBorder, border_width=1, border_style=line.style_dashed)
        else if showWeakOBTraps
            currentOBQuality := "🚨 WEAK OB (LIQUIDITY TRAP / IDM)"
            box.delete(lastWeakOBBox)
            lastWeakOBBox := box.new(bar_index - 2, high[2], bar_index + 20, low[2], bgcolor=colWeakOBTrap, border_color=colWeakOBBorder, border_width=1, border_style=line.style_dotted)
            label.new(bar_index - 2, high[2], "🚨 WEAK OB TRAP\n[Inducement Fuel]\nDO NOT SELL - TARGET AS LIQUIDITY!", color=#D32F2F, textcolor=color.white, style=label.style_label_down, size=size.tiny)

    // Same-Timeframe Body Close Invalidation Rule (Ep 15)
    if not na(lastActiveOBLow) and isLastOBBullish
        if (low < lastActiveOBLow) and (close >= lastActiveOBLow)
            label.new(bar_index, low, "🛡️ OB LIQUIDITY SWEPT!\n[Wick Sweep Only - OB Active]", color=#00E676, textcolor=color.black, style=label.style_label_up, size=size.tiny)
        else if (close < lastActiveOBLow)
            lastActiveOBLow := na
            currentOBQuality := "INVALIDATED (BODY BREAK)"

    if not na(lastActiveOBHigh) and not isLastOBBullish
        if (high > lastActiveOBHigh) and (close <= lastActiveOBHigh)
            label.new(bar_index, high, "🛡️ OB LIQUIDITY SWEPT!\n[Wick Sweep Only - OB Active]", color=#00E676, textcolor=color.black, style=label.style_label_down, size=size.tiny)
        else if (close > lastActiveOBHigh)
            lastActiveOBHigh := na
            currentOBQuality := "INVALIDATED (BODY BREAK)"

// ─── 8. CENTRAL BANK DEALERS RANGE (CBDR) ENGINE (EP 14) ────────────────────
bool inCBDRWindow = not na(time(timeframe.period, "1400-2000", nyTz))

var float cbdrHighBody  = na
var float cbdrLowBody   = na
var float cbdrRange     = na
var float cbdrRangePips = na
var bool  cbdrLocked    = false
var bool  isCBDRBlown   = false
var bool  isCBDRIdeal   = false
var box   cbdrBoxId     = na
var line  cbdrSD_m1     = na
var line  cbdrSD_m2     = na
var line  cbdrSD_p1     = na
var line  cbdrSD_p2     = na
var bool  dayLowConfirmed  = false
var bool  dayHighConfirmed = false
var float confirmedDayLow  = na
var float confirmedDayHigh = na

float pipFactor = (syminfo.mintick == 0.01 or syminfo.mintick == 0.001) ? 0.1 : 0.0001
if str.contains(syminfo.ticker, "XAU") or str.contains(syminfo.ticker, "GOLD")
    pipFactor := 0.1

if inCBDRWindow
    if not inCBDRWindow[1]
        cbdrHighBody     := math.max(open, close)
        cbdrLowBody      := math.min(open, close)
        cbdrRange        := na
        cbdrRangePips    := na
        cbdrLocked       := false
        isCBDRBlown      := false
        isCBDRIdeal      := false
        dayLowConfirmed  := false
        dayHighConfirmed := false
        confirmedDayLow  := na
        confirmedDayHigh := na
    else
        cbdrHighBody := math.max(cbdrHighBody, math.max(open, close))
        cbdrLowBody  := math.min(cbdrLowBody, math.min(open, close))

if not inCBDRWindow and inCBDRWindow[1] and not cbdrLocked and not na(cbdrHighBody) and not na(cbdrLowBody)
    cbdrLocked    := true
    cbdrRange     := cbdrHighBody - cbdrLowBody
    cbdrRangePips := cbdrRange / pipFactor
    isCBDRBlown   := cbdrRangePips > cbdrMaxPipFilter
    isCBDRIdeal   := cbdrRangePips >= cbdrIdealMinPips and cbdrRangePips <= cbdrIdealMaxPips
    
    if enableCBDR and showCBDRBox
        box.delete(cbdrBoxId)
        color bg = isCBDRBlown ? color.new(color.red, 85) : colCBDRBox
        color br = isCBDRBlown ? color.red : colCBDRBorder
        cbdrBoxId := box.new(bar_index - 24, cbdrHighBody, bar_index, cbdrLowBody, bgcolor=bg, border_color=br, border_width=2)

    if enableCBDR and showCBDR_SDs and not isCBDRBlown
        line.delete(cbdrSD_m1)
        line.delete(cbdrSD_m2)
        line.delete(cbdrSD_p1)
        line.delete(cbdrSD_p2)
        float sdm1 = cbdrLowBody - (1.0 * cbdrRange)
        float sdm2 = cbdrLowBody - (2.0 * cbdrRange)
        float sdp1 = cbdrHighBody + (1.0 * cbdrRange)
        float sdp2 = cbdrHighBody + (2.0 * cbdrRange)
        cbdrSD_m1 := line.new(bar_index, sdm1, bar_index + 48, sdm1, color=colSD_DayLow, width=2, style=line.style_dashed)
        cbdrSD_m2 := line.new(bar_index, sdm2, bar_index + 48, sdm2, color=colSD_DayLow, width=2, style=line.style_solid)
        cbdrSD_p1 := line.new(bar_index, sdp1, bar_index + 48, sdp1, color=colSD_DayHigh, width=2, style=line.style_dashed)
        cbdrSD_p2 := line.new(bar_index, sdp2, bar_index + 48, sdp2, color=colSD_DayHigh, width=2, style=line.style_solid)

// CBDR Reversal Confirmation
if enableCBDR and cbdrLocked and not isCBDRBlown
    float checkSD_m1 = cbdrLowBody - (1.0 * cbdrRange)
    float checkSD_p1 = cbdrHighBody + (1.0 * cbdrRange)
    if isBullishDayBias and not dayLowConfirmed
        if (low <= checkSD_m1) and (currentMSSState == "BULLISH MSS CONFIRMED" or bullMSS_Trigger)
            dayLowConfirmed := true
            confirmedDayLow := low
            label.new(bar_index, low - (atrVal * 0.5), "🏛️ CBDR DAY LOW CONFIRMED!\n[SD -1/-2 Reversal + 5m MSS]", color=colSD_DayLow, textcolor=color.black, style=label.style_label_up, size=size.small)
    if not isBullishDayBias and not dayHighConfirmed
        if (high >= checkSD_p1) and (currentMSSState == "BEARISH MSS CONFIRMED" or bearMSS_Trigger)
            dayHighConfirmed := true
            confirmedDayHigh := high
            label.new(bar_index, high + (atrVal * 0.5), "🏛️ CBDR DAY HIGH CONFIRMED!\n[SD +1/+2 Reversal + 5m MSS]", color=colSD_DayHigh, textcolor=color.white, style=label.style_label_down, size=size.small)

// ─── 9. KILLZONES & SESSION EXECUTION MODELS (EP 11 & 12) ───────────────────
bool inPreAsianWindow = not na(time(timeframe.period, "1530-2000", nyTz))
bool inAsianKillzone  = not na(time(timeframe.period, "2000-0000", nyTz))
bool inLondonKillzone = not na(time(timeframe.period, "0200-0500", nyTz))
bool inNYKillzone     = not na(time(timeframe.period, "0700-1000", nyTz))
bool inLondonCloseKZ  = not na(time(timeframe.period, "1000-1200", nyTz))

bgcolor(enableKillzones and showSessionBoxes and inAsianKillzone ? colAsianSession : na, title="Asian Killzone")
bgcolor(enableKillzones and showSessionBoxes and inLondonKillzone ? colLondonSession : na, title="London Killzone")
bgcolor(enableKillzones and showSessionBoxes and inNYKillzone ? colNYSession : na, title="NY Killzone")
bgcolor(enableKillzones and showSessionBoxes and inLondonCloseKZ ? colLondonClose : na, title="London Close")
bgcolor(enablePreAsian and showSessionBoxes and inPreAsianWindow ? colPreAsian : na, title="Pre-Asian Window")

// Asian & London Tracking
var float kzAsianHigh = na
var float kzAsianLow  = na
if inAsianKillzone
    if not inAsianKillzone[1]
        kzAsianHigh := high
        kzAsianLow  := low
    else
        kzAsianHigh := math.max(kzAsianHigh, high)
        kzAsianLow  := math.min(kzAsianLow, low)

var bool londonTradeDone = false
if not inLondonKillzone
    londonTradeDone := false

bool londonAsianPurgeLong  = false
bool londonAsianPurgeShort = false

if enableLondonStrat and inLondonKillzone and not londonTradeDone
    if isBullishDayBias and not na(kzAsianLow) and (low < kzAsianLow) and (close > kzAsianLow)
        londonTradeDone := true
        londonAsianPurgeLong := true
        label.new(bar_index, low - (atrVal * 0.5), "☕ EP 12 LONDON MODEL 1 LONG\n[Asian Low Purged -> Target Asian High]", color=#00E676, textcolor=color.black, style=label.style_label_up, size=size.normal)
    else if not isBullishDayBias and not na(kzAsianHigh) and (high > kzAsianHigh) and (close < kzAsianHigh)
        londonTradeDone := true
        londonAsianPurgeShort := true
        label.new(bar_index, high + (atrVal * 0.5), "☕ EP 12 LONDON MODEL 1 SHORT\n[Asian High Purged -> Target Asian Low]", color=#FF1744, textcolor=color.white, style=label.style_label_down, size=size.normal)

// ─── 10. 5 MASTER ENTRY MODELS & VALUATION GATE (EP 08 & 09) ────────────────
bool sigBuyModel1 = (currentMSSState == "BULLISH MSS CONFIRMED") and not na(latestBullFVG_Top) and not latestBullFVG_Mitigated and (low <= latestBullFVG_Top) and (close >= latestBullFVG_Bottom) and (bar_index - lastBullMSS_Bar <= 15)
bool sigSellModel1 = (currentMSSState == "BEARISH MSS CONFIRMED") and not na(latestBearFVG_Bottom) and not latestBearFVG_Mitigated and (high >= latestBearFVG_Bottom) and (close <= latestBearFVG_Top) and (bar_index - lastBearMSS_Bar <= 15)

if sigBuyModel1
    latestBullFVG_Mitigated := true

if sigSellModel1
    latestBearFVG_Mitigated := true

bool sigBuyModel2 = not na(activeSwingHigh) and ((activeSwingHigh - close) > (atrVal * 3.0)) and isBullDisp[1] and not na(latestBullFVG_Top) and (low <= latestBullFVG_Top)
bool sigSellModel2 = not na(activeSwingLow) and ((close - activeSwingLow) > (atrVal * 3.0)) and isBearDisp[1] and not na(latestBearFVG_Bottom) and (high >= latestBearFVG_Bottom)

bool sigBuyModel3 = (dailyBiasState == "BULLISH RUN (PDH Expansion)") and isBullDisp and not na(latestBullFVG_Top) and (low <= latestBullFVG_Top)
bool sigSellModel3 = (dailyBiasState == "BEARISH RUN (PDL Expansion)") and isBearDisp and not na(latestBearFVG_Bottom) and (high >= latestBearFVG_Bottom)

bool sigBuyModel5 = (pdlSwept or asianLowSwept or londonAsianPurgeLong) and isBullDisp
bool sigSellModel5 = (pdhSwept or asianHighSwept or londonAsianPurgeShort) and isBearDisp

// Valuation Gate (Ep 09: Long in Discount Only, Short in Premium Only)
bool isExpansionRunBull = (candleBody >= (atrVal * 1.8)) and isBullFVG
bool isExpansionRunBear = (candleBody >= (atrVal * 1.8)) and isBearFVG

bool buyAllowed  = enforceValuation ? (isInDiscount or allowLRL_Bypass or isExpansionRunBull) : true
bool sellAllowed = enforceValuation ? (isInPremium or allowLRL_Bypass or isExpansionRunBear) : true

if not buyAllowed
    sigBuyModel1 := false
    sigBuyModel2 := false
    sigBuyModel3 := false
    sigBuyModel5 := false

if not sellAllowed
    sigSellModel1 := false
    sigSellModel2 := false
    sigSellModel3 := false
    sigSellModel5 := false

// Final Signal Arbitration
bool finalBuySignal  = false
bool finalSellSignal = false
string activeSignalModel = ""

if entryMode == "Model 1: Standard MSS Retest"
    finalBuySignal    := sigBuyModel1
    finalSellSignal   := sigSellModel1
    activeSignalModel := "MODEL 1 (Standard MSS)"
else if entryMode == "Model 2: Aggressive No-MSS"
    finalBuySignal    := sigBuyModel2
    finalSellSignal   := sigSellModel2
    activeSignalModel := "MODEL 2 (Aggressive No-MSS)"
else if entryMode == "Model 3: LRL Fast Execution"
    finalBuySignal    := sigBuyModel3
    finalSellSignal   := sigSellModel3
    activeSignalModel := "MODEL 3 (LRL Fast Run)"
else if entryMode == "Model 5: Sweep Turtle Soup"
    finalBuySignal    := sigBuyModel5
    finalSellSignal   := sigSellModel5
    activeSignalModel := "MODEL 5 (Turtle Soup Sweep)"
else // All Models
    if sigBuyModel1
        finalBuySignal := true
        activeSignalModel := "MODEL 1 (Standard MSS)"
    else if sigBuyModel5
        finalBuySignal := true
        activeSignalModel := "MODEL 5 (Turtle Soup)"
    else if sigBuyModel3
        finalBuySignal := true
        activeSignalModel := "MODEL 3 (LRL Fast)"
    else if sigBuyModel2
        finalBuySignal := true
        activeSignalModel := "MODEL 2 (Aggressive)"
        
    if sigSellModel1
        finalSellSignal := true
        activeSignalModel := "MODEL 1 (Standard MSS)"
    else if sigSellModel5
        finalSellSignal := true
        activeSignalModel := "MODEL 5 (Turtle Soup)"
    else if sigSellModel3
        finalSellSignal := true
        activeSignalModel := "MODEL 3 (LRL Fast)"
    else if sigSellModel2
        finalSellSignal := true
        activeSignalModel := "MODEL 2 (Aggressive)"

// ─── 11. DYNAMIC PROFIT ARMOR & TRADE MANAGEMENT (EP 06–09) ─────────────────
var float activeEntryPrice = na
var float activeSLPrice    = na
var float activeBEPrice    = na
var float activeTPPrice    = na
var bool  isTradeActive    = false
var bool  isLongTrade      = false

// Position Sizing Calculator
float maxDollarRisk  = accountCapital * (riskPctPerTrade / 100.0)
float estSLDistance  = atrVal * 1.5
float safeMinTick    = nz(syminfo.mintick, 0.0001) > 0 ? nz(syminfo.mintick, 0.0001) : 0.0001
float estSLPips      = estSLDistance / (safeMinTick * 10.0)
float recLotSize     = estSLPips > 0 ? (maxDollarRisk / estSLPips) : 0.01
recLotSize          := math.round(math.max(0.01, math.min(recLotSize, 1.0)), 2)

if finalBuySignal and not isTradeActive
    isTradeActive    := true
    isLongTrade      := true
    activeEntryPrice := close
    float buySLDist  = math.max(atrVal * 1.2, math.abs(close - nz(activeSwingLow, close - atrVal)))
    activeSLPrice    := close - buySLDist
    activeBEPrice    := close + (buySLDist * beTriggerRR)
    activeTPPrice    := close + (buySLDist * targetRR)
    
    label.new(bar_index, low - (atrVal * 0.5), "🏛️ HERMES LONG (" + (isInDiscount ? "DISCOUNT" : "EXPANSION") + ")\n" + activeSignalModel + "\nEntry: " + str.tostring(close, "#.##") + "\nTP (+2.8%): " + str.tostring(activeTPPrice, "#.##") + " | SL: " + str.tostring(activeSLPrice, "#.##") + "\nLot: " + str.tostring(recLotSize), color=colBuySignal, textcolor=color.black, style=label.style_label_up, size=size.normal)

if finalSellSignal and not isTradeActive
    isTradeActive    := true
    isLongTrade      := false
    activeEntryPrice := close
    float sellSLDist = math.max(atrVal * 1.2, math.abs(nz(activeSwingHigh, close + atrVal) - close))
    activeSLPrice    := close + sellSLDist
    activeBEPrice    := close - (sellSLDist * beTriggerRR)
    activeTPPrice    := close - (sellSLDist * targetRR)
    
    label.new(bar_index, high + (atrVal * 0.5), "🏛️ HERMES SHORT (" + (isInPremium ? "PREMIUM" : "EXPANSION") + ")\n" + activeSignalModel + "\nEntry: " + str.tostring(close, "#.##") + "\nTP (+2.8%): " + str.tostring(activeTPPrice, "#.##") + " | SL: " + str.tostring(activeSLPrice, "#.##") + "\nLot: " + str.tostring(recLotSize), color=colSellSignal, textcolor=color.white, style=label.style_label_down, size=size.normal)

// Dynamic Profit Armor: Breakeven Shift
if isTradeActive
    if isLongTrade
        if high >= activeBEPrice and activeSLPrice < activeEntryPrice
            activeSLPrice := activeEntryPrice
            label.new(bar_index, high, "🛡️ PROFIT ARMOR: SL SHIFTED TO BREAKEVEN ($0.00 RISK)!", color=color.blue, textcolor=color.white, style=label.style_label_down, size=size.small)
        if high >= activeTPPrice or low <= activeSLPrice
            isTradeActive := false
    else
        if low <= activeBEPrice and activeSLPrice > activeEntryPrice
            activeSLPrice := activeEntryPrice
            label.new(bar_index, low, "🛡️ PROFIT ARMOR: SL SHIFTED TO BREAKEVEN ($0.00 RISK)!", color=color.blue, textcolor=color.white, style=label.style_label_up, size=size.small)
        if low <= activeTPPrice or high >= activeSLPrice
            isTradeActive := false

// ─── 12. INSTITUTIONAL MASTER HUD DASHBOARD (EP 13 & 15) ────────────────────
var table hud = table.new(position.top_right, 2, 12, bgcolor=color.new(color.black, 20), border_color=color.gray, border_width=1)
if showHUD and barstate.islast
    table.cell(hud, 0, 0, "🏛️ HERMES SMC ENGINE", bgcolor=#1E88E5, text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "15-PILLAR UNIFIED ACTIVE", bgcolor=#1E88E5, text_color=color.black, text_size=size.small)
    
    table.cell(hud, 0, 1, "Valuation Territory:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 1, isInDiscount ? "🟢 DISCOUNT (BUY ONLY)" : (isInPremium ? "🔴 PREMIUM (SELL ONLY)" : "EQUILIBRIUM"), text_color=(isInDiscount ? colDiscount : colPremium), text_size=size.small)
    
    table.cell(hud, 0, 2, "0.50 Equilibrium:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 2, na(equilibrium05) ? "Calculating..." : "$" + str.tostring(equilibrium05, "#.##"), text_color=colEquilibrium, text_size=size.small)
    
    table.cell(hud, 0, 3, "Current MSS State:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 3, currentMSSState, text_color=(currentMSSState == "BULLISH MSS CONFIRMED" ? colBuySignal : (currentMSSState == "BEARISH MSS CONFIRMED" ? colSellSignal : color.gray)), text_size=size.small)
    
    table.cell(hud, 0, 4, "Daily Bias Narrative:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 4, dailyBiasState, text_color=#FFD600, text_size=size.small)
    
    table.cell(hud, 0, 5, "7-OB Classifier Quality:", text_color=color.white, text_size=size.small)
    color obQCol = str.contains(currentOBQuality, "STRONGEST") ? #00E676 : (str.contains(currentOBQuality, "STRONG") ? #1E88E5 : (str.contains(currentOBQuality, "WEAK") ? #FF1744 : #FFB300))
    table.cell(hud, 1, 5, currentOBQuality, text_color=obQCol, text_size=size.small)
    
    string currentKZ = inAsianKillzone ? "🌙 ASIAN (20:00-00:00)" : (inLondonKillzone ? "☕ LONDON (02:00-05:00)" : (inNYKillzone ? "🗽 NEW YORK (07:00-10:00)" : (inPreAsianWindow ? "🔍 PRE-ASIAN (15:30-20:00)" : "OFF-SESSION")))
    table.cell(hud, 0, 6, "Active Killzone Window:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 6, currentKZ, text_color=#FF9100, text_size=size.small)
    
    string cbdrTxt = not enableCBDR ? "DISABLED" : (dayLowConfirmed ? "🟢 DAY LOW LOCKED" : (dayHighConfirmed ? "🔴 DAY HIGH LOCKED" : (cbdrLocked ? "LOCKED (" + str.tostring(cbdrRangePips, "#") + "P)" : "CALCULATING")))
    table.cell(hud, 0, 7, "CBDR Predictor Status:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 7, cbdrTxt, text_color=#00E5FF, text_size=size.small)
    
    table.cell(hud, 0, 8, "OTE Golden Pocket:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 8, inBullOTE ? "🟢 BULLISH OTE ACTIVE" : (inBearOTE ? "🔴 BEARISH OTE ACTIVE" : "OUTSIDE OTE"), text_color=(inBullOTE or inBearOTE ? #FFD700 : color.gray), text_size=size.small)
    
    table.cell(hud, 0, 9, "Dynamic Profit Armor:", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 9, "LOCKED: +1.0% BE / +2.8% TP", text_color=#00E676, text_size=size.small)
    
    table.cell(hud, 0, 10, "Position Sizing (5x):", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 10, "$" + str.tostring(accountCapital, "#") + " Base -> " + str.tostring(recLotSize) + " Lots", text_color=#FFE57F, text_size=size.small)

// ─── 13. TRADINGVIEW REAL-TIME INSTITUTIONAL ALERT CONDITIONS ───────────────
alertcondition(finalBuySignal,  title="🏛️ Hermes Institutional BUY Signal",  message="🏛️ HERMES BUY: All 5 Institutional Gates Passed! Entry at {{close}} | Target: +2.8% TP | Risk Armor Active.")
alertcondition(finalSellSignal, title="🏛️ Hermes Institutional SELL Signal", message="🏛️ HERMES SELL: All 5 Institutional Gates Passed! Entry at {{close}} | Target: +2.8% TP | Risk Armor Active.")
alertcondition(asianHighSwept or asianLowSwept, title="⚡ Asian Session Liquidity Swept", message="⚡ HERMES ALERT: Asian Range Extreme Swept! London / NY Manipulation Active.")
alertcondition(str.contains(currentOBQuality, "STRONGEST"), title="⚡ Strongest Conditional OB Created", message="⚡ HERMES ALERT: Strongest Conditional Order Block Created (Post-Sweep / IDM Purged) at {{close}}!")
alertcondition(dayLowConfirmed or dayHighConfirmed, title="🏛️ CBDR Day High/Low Confirmed", message="🏛️ HERMES ALERT: CBDR Standard Deviation Extreme Reached & Reversing!")
