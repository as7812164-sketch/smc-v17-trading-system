//@version=5
strategy("HERMES MSOB 4.0 - Advanced Structure Strategy (ITH/ITL/STH/STL)", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=10, max_boxes_count=100, max_lines_count=100, max_labels_count=100)

// ==============================================================================
// 🏛️ HERMES AI INSTITUTIONAL ADVANCED STRUCTURE STRATEGY
// Source: Shoaib Khan (MS Trading) - Advanced Structure Mapping (ITH, ITL, STH, STL)
// Link: https://youtu.be/VZZ81llZsmQ
// ==============================================================================

// --- Inputs ---
i_trail_sl      = input.bool(true,  "Enable Dynamic STL Trailing Stop Loss", group="Trade Management")
i_show_fractals = input.bool(true,  "Show 3-Bar STH / STL Dots", group="Visuals")
i_show_it_lines = input.bool(true,  "Show Protected ITH / ITL Lines", group="Visuals")
i_sl_buffer_pct = input.float(0.1,  "SL Buffer below ITL (%)", group="Risk Management") / 100.0

// --- Level 1: 3-Bar Fractal Detection (Short Term High & Low) ---
// An STL has Left Low > Center Low < Right Low
bool is_stl = (low[1] < low[2]) and (low[1] < low[0])
// An STH has Left High < Center High > Right High
bool is_sth = (high[1] > high[2]) and (high[1] > high[0])

float stl_price = is_stl ? low[1] : na
float sth_price = is_sth ? high[1] : na
int   stl_bar   = is_stl ? bar_index[1] : na
int   sth_bar   = is_sth ? bar_index[1] : na

// Plot Minor Short Term Swings
plotshape(i_show_fractals and is_stl, title="STL Dot", style=shape.circle, location=location.belowbar, color=color.new(color.blue, 30), size=size.tiny, offset=-1)
plotshape(i_show_fractals and is_sth, title="STH Dot", style=shape.circle, location=location.abovebar, color=color.new(color.orange, 30), size=size.tiny, offset=-1)

// --- Level 2: Intermediate Term High & Low Construction ---
var float[] confirmed_stls = array.new_float()
var int[]   confirmed_stl_bars = array.new_int()
var float[] confirmed_sths = array.new_float()
var int[]   confirmed_sth_bars = array.new_int()

var float active_itl = na
var float active_ith = na
var int   active_itl_bar = na
var int   active_ith_bar = na

bool new_itl_formed = false
bool new_ith_formed = false

if is_stl
    array.push(confirmed_stls, low[1])
    array.push(confirmed_stl_bars, bar_index[1])
    if array.size(confirmed_stls) >= 3
        int sz = array.size(confirmed_stls)
        float left_stl   = array.get(confirmed_stls, sz - 3)
        float center_stl = array.get(confirmed_stls, sz - 2)
        float right_stl  = array.get(confirmed_stls, sz - 1)
        int   c_bar      = array.get(confirmed_stl_bars, sz - 2)
        
        // ITL Condition: Left STL > Center STL < Right STL
        if (center_stl < left_stl) and (center_stl < right_stl) and (na(active_itl) or center_stl != active_itl)
            active_itl := center_stl
            active_itl_bar := c_bar
            new_itl_formed := true
            if i_show_it_lines
                line.new(c_bar, center_stl, bar_index, center_stl, color=color.green, width=2, style=line.style_solid)
                label.new(c_bar, center_stl, "ITL (Protected Floor 🛡️)", textcolor=color.green, style=label.style_label_up, size=size.small)

if is_sth
    array.push(confirmed_sths, high[1])
    array.push(confirmed_sth_bars, bar_index[1])
    if array.size(confirmed_sths) >= 3
        int sz = array.size(confirmed_sths)
        float left_sth   = array.get(confirmed_sths, sz - 3)
        float center_sth = array.get(confirmed_sths, sz - 2)
        float right_sth  = array.get(confirmed_sths, sz - 1)
        int   c_bar      = array.get(confirmed_sth_bars, sz - 2)
        
        // ITH Condition: Left STH < Center STH > Right STH
        if (center_sth > left_sth) and (center_sth > right_sth) and (na(active_ith) or center_sth != active_ith)
            active_ith := center_sth
            active_ith_bar := c_bar
            new_ith_formed := true
            if i_show_it_lines
                line.new(c_bar, center_sth, bar_index, center_sth, color=color.red, width=2, style=line.style_solid)
                label.new(c_bar, center_sth, "ITH (Target Ceiling 🎯)", textcolor=color.red, style=label.style_label_down, size=size.small)

// --- Strategy Execution Logic ---
var float trade_sl = na
var float trade_tp = na
var line  sl_line  = na
var line  tp_line  = na

// Long Entry Condition: Fresh ITL Confirmed + Candle Body closes above Right STL High
if new_itl_formed and strategy.position_size == 0
    trade_sl := active_itl * (1.0 - i_sl_buffer_pct)
    trade_tp := not na(active_ith) and active_ith > close ? active_ith : close * 1.05
    strategy.entry("Long_ITL", strategy.long)
    
    if i_show_it_lines
        line.delete(sl_line)
        line.delete(tp_line)
        sl_line := line.new(bar_index, trade_sl, bar_index + 10, trade_sl, color=color.red, width=2, style=line.style_dashed)
        tp_line := line.new(bar_index, trade_tp, bar_index + 10, trade_tp, color=color.green, width=2, style=line.style_dashed)

// Dynamic Trailing Stop Loss below confirmed STLs (Shoaib Khan Rule)
if strategy.position_size > 0 and i_trail_sl
    if array.size(confirmed_stls) >= 2
        // Trail to second-to-last confirmed STL
        float safe_stl = array.get(confirmed_stls, array.size(confirmed_stls) - 2)
        if safe_stl > trade_sl and safe_stl < close
            trade_sl := safe_stl
            line.set_y1(sl_line, trade_sl)
            line.set_y2(sl_line, trade_sl)
            line.set_x2(sl_line, bar_index + 5)

// Order Exits
if strategy.position_size > 0
    // Stop Loss Check
    if close < trade_sl
        strategy.close("Long_ITL", comment="SL_Hit_or_Trailed")
    // Target Check
    else if high >= trade_tp
        strategy.close("Long_ITL", comment="ITH_Target_Hit_🎯")

// --- HUD Table Dashboard ---
var table hud = table.new(position.top_right, 2, 4, bgcolor=color.new(color.black, 15), border_color=color.gray, border_width=1)
if barstate.islast
    table.cell(hud, 0, 0, "HERMES ADVANCED", text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "STRUCTURE HUD", text_color=color.aqua, text_size=size.small)
    
    table.cell(hud, 0, 1, "Active ITL (Floor)", text_color=color.white, text_size=size.tiny)
    table.cell(hud, 1, 1, na(active_itl) ? "Searching..." : str.tostring(active_itl, "#.##"), text_color=color.green, text_size=size.tiny)
    
    table.cell(hud, 0, 2, "Active ITH (Target)", text_color=color.white, text_size=size.tiny)
    table.cell(hud, 1, 2, na(active_ith) ? "Searching..." : str.tostring(active_ith, "#.##"), text_color=color.orange, text_size=size.tiny)
    
    table.cell(hud, 0, 3, "Trailing SL Status", text_color=color.white, text_size=size.tiny)
    table.cell(hud, 1, 3, strategy.position_size > 0 ? "ARMED: " + str.tostring(trade_sl, "#.##") : "STANDBY ⚪", text_color=color.yellow, text_size=size.tiny)
