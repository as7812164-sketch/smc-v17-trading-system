// ══════════════════════════════════════════════════════════════════════════════
// ██╗  ██╗███████╗██████╗ ███╗   ███╗███████╗███████╗    ███████╗███╗   ███╗ ██████╗
// ██║  ██║██╔════╝██╔══██╗████╗ ████║██╔════╝██╔════╝    ██╔════╝████╗ ████║██╔════╝
// ███████║█████╗  ██████╔╝██╔████╔██║█████╗  ███████╗    ███████╗██╔████╔██║██║     
// ██╔══██║██╔══╝  ██╔══██╗██║╚██╔╝██║██╔══╝  ╚════██║    ╚════██║██║╚██╔╝██║██║     
// ██║  ██║███████╗██║  ██║██║ ╚═╝ ██║███████╗███████║    ███████║██║ ╚═╝ ██║╚██████╗
// ╚═╝  ╚═╝╚══════╝╚═╝  ╚═╝╚═╝     ╚═╝╚══════╝╚══════╝    ╚══════╝╚═╝     ╚═╝ ╚═════╝
// ══════════════════════════════════════════════════════════════════════════════
// HERMES SMC ENGINE v1.0 — Institutional Smart Money Concepts
// Built by Hermes AI Quant Division
// Zero Retail Indicators | Zero Repainting | 4-Rule Validated Order Blocks
// Dynamic 50% Mean Threshold (MT) Tap Freeze & Historical Mitigated Archive
// ══════════════════════════════════════════════════════════════════════════════
//@version=5
indicator("Hermes SMC Engine v1.0", "⚡ Hermes SMC", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
// ██ SETTINGS PANEL (TradingView Settings ⚙️)
// ══════════════════════════════════════════════════════════════════════════════

// ── 1. Order Blocks (OB) & Mean Threshold Settings ──
grp_ob            = "═══ 1. Institutional Order Blocks (OB) ═══"
showOB            = input.bool(true,                         "Show Order Blocks",                  group=grp_ob, tooltip="Identify high-probability institutional supply and demand zones.")
obMitTrigger      = input.string("50% Mean Threshold (MT)", "Mitigation Trigger Level",           options=["50% Mean Threshold (MT)", "First Touch (Wick Entry)", "Full Breakout (Invalidation)"], group=grp_ob, tooltip="Institutional standard: 50% Mean Threshold (MT) freezes the OB right boundary at the exact tap bar.")
showHistoricalOB  = input.bool(true,                         "Show Historical Mitigated OBs",       group=grp_ob, tooltip="Keep past mitigated zones on chart with dashed borders for institutional backtesting.")
obDispMult        = input.float(1.8,                        "Displacement Multiplier (×ATR)",     minval=1.0, maxval=5.0, step=0.1, group=grp_ob, tooltip="Minimum displacement candle size required to validate an OB.")
obAtrPeriod       = input.int(14,                           "ATR Lookback Period",                minval=5, maxval=50, group=grp_ob)
obMaxActive       = input.int(8,                            "Max Active (Unmitigated) OBs",       minval=1, maxval=30, group=grp_ob, tooltip="Maximum active extending zones on screen.")
obMaxHistorical   = input.int(50,                           "Max Historical Mitigated OBs",       minval=5, maxval=150, group=grp_ob, tooltip="Buffer size for historical frozen zones (max 500 total elements in Pine).")

// ── 2. Fair Value Gaps (FVG) Settings ──
grp_fvg           = "═══ 2. Fair Value Gaps (FVG) ═══"
showFVG           = input.bool(false,                        "Show Fair Value Gaps (FVG)",         group=grp_fvg, tooltip="Display 3-candle institutional liquidity imbalances.")
fvgMinMult        = input.float(0.35,                       "Min FVG Size (×ATR)",                minval=0.1, maxval=2.0, step=0.05, group=grp_fvg)
fvgShowCE         = input.bool(true,                         "Show Consequent Encroachment (50%)", group=grp_fvg, tooltip="Display the 50% midline (CE) inside FVGs.")
fvgMaxCount       = input.int(10,                           "Max Active FVGs",                    minval=1, maxval=30, group=grp_fvg)

// ── 3. Market Structure Settings ──
grp_struct        = "═══ 3. Market Structure (BOS / CHoCH) ═══"
swingLen          = input.int(5,                            "Swing Lookback Period",              minval=2, maxval=20, group=grp_struct, tooltip="Bars to left and right for swing pivot qualification.")
showBOS           = input.bool(false,                        "Show Break of Structure (BOS)",      group=grp_struct, tooltip="Trend continuation break (candle body close).")
showCHoCH         = input.bool(false,                        "Show Change of Character (CHoCH)",   group=grp_struct, tooltip="Market structure shift / trend reversal signal.")
showSweeps        = input.bool(false,                        "Show Liquidity Sweeps",              group=grp_struct, tooltip="Wick-only sweeps of swing highs/lows with candle close inside.")

// ── 4. Liquidity & Inducement (IDM) Settings ──
grp_liq           = "═══ 4. Liquidity & Inducement (IDM) ═══"
showIDM           = input.bool(false,                        "Show Inducement (IDM)",              group=grp_liq, tooltip="First internal pullback high/low following a major BOS.")
showEQHL          = input.bool(false,                        "Show Equal Highs / Lows (EQH/EQL)",  group=grp_liq, tooltip="Highlight double tops/bottoms where retail liquidity clusters.")
eqTolerance       = input.float(0.08,                       "EQ H/L Tolerance (%)",               minval=0.01, maxval=0.5, step=0.01, group=grp_liq)

// ── 5. Premium / Discount & OTE Settings ──
grp_pd            = "═══ 5. Premium / Discount & OTE ═══"
showPD            = input.bool(true,                         "Show Premium / Discount Zones",      group=grp_pd, tooltip="Equilibrium dealing range (50% midpoint between major swing high and low).")
showOTE           = input.bool(true,                         "Show Optimal Trade Entry (OTE)",     group=grp_pd, tooltip="Fibonacci retracement levels 0.618, 0.705, and 0.786.")
pdBgOpacity       = input.int(92,                           "P/D Background Opacity (%)",         minval=80, maxval=98, group=grp_pd)

// ── 6. Colors & Visual Styling ──
grp_colors        = "═══ 6. Visual Colors & Theme ═══"
colBullOB         = input.color(color.new(#00E676, 0),       "Bullish Demand OB (Active)",         group=grp_colors)
colBearOB         = input.color(color.new(#FF1744, 0),       "Bearish Supply OB (Active)",         group=grp_colors)
colMitOB          = input.color(color.new(#787B86, 0),       "Mitigated Historical OB Tint",       group=grp_colors)
colBullFVG        = input.color(color.new(#00BCD4, 0),       "Bullish FVG",                        group=grp_colors)
colBearFVG        = input.color(color.new(#E040FB, 0),       "Bearish FVG",                        group=grp_colors)
colBullBOS        = input.color(color.new(#2196F3, 0),       "BOS Bullish",                        group=grp_colors)
colBearBOS        = input.color(color.new(#2196F3, 0),       "BOS Bearish",                        group=grp_colors)
colBullCHoCH      = input.color(color.new(#FF9800, 0),       "CHoCH Bullish",                      group=grp_colors)
colBearCHoCH      = input.color(color.new(#FF9800, 0),       "CHoCH Bearish",                      group=grp_colors)
colSweep          = input.color(color.new(#FF5722, 0),       "Liquidity Sweep",                    group=grp_colors)
colIDM            = input.color(color.new(#FFC107, 0),       "Inducement Marker",                  group=grp_colors)
colPremium        = input.color(color.new(#FF1744, 94),      "Premium Range Fill",                 group=grp_colors)
colDiscount       = input.color(color.new(#00E676, 94),      "Discount Range Fill",                group=grp_colors)
colEQ             = input.color(color.new(#9E9E9E, 40),      "Equilibrium Line",                   group=grp_colors)

// ══════════════════════════════════════════════════════════════════════════════
// ██ CORE ENGINE CONSTANTS & UTILITIES
// ══════════════════════════════════════════════════════════════════════════════
confirmed = barstate.isconfirmed
atrVal    = ta.atr(obAtrPeriod)

// ══════════════════════════════════════════════════════════════════════════════
// ██ MODULE 1: MARKET STRUCTURE ENGINE (SWINGS, BOS, CHoCH, SWEEPS)
// ══════════════════════════════════════════════════════════════════════════════
swingHigh = ta.pivothigh(high, swingLen, swingLen)
swingLow  = ta.pivotlow(low, swingLen, swingLen)

var float lastSwingHigh      = na
var float lastSwingLow       = na
var int   lastSwingHighBar   = na
var int   lastSwingLowBar    = na
var float prevSwingHigh      = na
var float prevSwingLow       = na
var int   prevSwingHighBar   = na
var int   prevSwingLowBar    = na

var int   trendState         = 0  // 1 = Bullish, -1 = Bearish
var float protectedHigh      = na
var float protectedLow       = na
var int   protectedHighBar   = na
var int   protectedLowBar    = na

pivotOffset = swingLen

if not na(swingHigh)
    prevSwingHigh    := lastSwingHigh
    prevSwingHighBar := lastSwingHighBar
    lastSwingHigh    := swingHigh
    lastSwingHighBar := bar_index - pivotOffset

if not na(swingLow)
    prevSwingLow     := lastSwingLow
    prevSwingLowBar  := lastSwingLowBar
    lastSwingLow     := swingLow
    lastSwingLowBar  := bar_index - pivotOffset

var bool bullBOS_signal    = false
var bool bearBOS_signal    = false
var bool bullCHoCH_signal  = false
var bool bearCHoCH_signal  = false
var bool bullSweep_signal  = false
var bool bearSweep_signal  = false

bullBOS_signal   := false
bearBOS_signal   := false
bullCHoCH_signal := false
bearCHoCH_signal := false
bullSweep_signal := false
bearSweep_signal := false

if confirmed and not na(lastSwingHigh)
    if close > lastSwingHigh and close[1] <= lastSwingHigh
        if trendState == 1 or trendState == 0
            bullBOS_signal := true
            protectedLow    := lastSwingLow
            protectedLowBar := lastSwingLowBar
        else
            bullCHoCH_signal := true
            protectedLow     := lastSwingLow
            protectedLowBar  := lastSwingLowBar
        trendState := 1
    else if high > lastSwingHigh and close <= lastSwingHigh
        bullSweep_signal := true

if confirmed and not na(lastSwingLow)
    if close < lastSwingLow and close[1] >= lastSwingLow
        if trendState == -1 or trendState == 0
            bearBOS_signal := true
            protectedHigh    := lastSwingHigh
            protectedHighBar := lastSwingHighBar
        else
            bearCHoCH_signal := true
            protectedHigh    := lastSwingHigh
            protectedHighBar := lastSwingHighBar
        trendState := -1
    else if low < lastSwingLow and close >= lastSwingLow
        bearSweep_signal := true

// ── Render Structure Lines & Labels ──
if bullBOS_signal and showBOS
    line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=colBullBOS, style=line.style_dashed, width=1)
    label.new(bar_index, lastSwingHigh, "BOS ▲", color=color.new(color.black, 100), textcolor=colBullBOS, style=label.style_label_down, size=size.tiny)

if bearBOS_signal and showBOS
    line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=colBearBOS, style=line.style_dashed, width=1)
    label.new(bar_index, lastSwingLow, "BOS ▼", color=color.new(color.black, 100), textcolor=colBearBOS, style=label.style_label_up, size=size.tiny)

if bullCHoCH_signal and showCHoCH
    line.new(lastSwingHighBar, lastSwingHigh, bar_index, lastSwingHigh, color=colBullCHoCH, style=line.style_solid, width=2)
    label.new(bar_index, lastSwingHigh, "CHoCH ▲", color=color.new(color.black, 100), textcolor=colBullCHoCH, style=label.style_label_down, size=size.small)

if bearCHoCH_signal and showCHoCH
    line.new(lastSwingLowBar, lastSwingLow, bar_index, lastSwingLow, color=colBearCHoCH, style=line.style_solid, width=2)
    label.new(bar_index, lastSwingLow, "CHoCH ▼", color=color.new(color.black, 100), textcolor=colBearCHoCH, style=label.style_label_up, size=size.small)

if bullSweep_signal and showSweeps
    label.new(bar_index, high, "⚡ Sweep", color=color.new(color.black, 100), textcolor=colSweep, style=label.style_label_down, size=size.tiny)

if bearSweep_signal and showSweeps
    label.new(bar_index, low, "⚡ Sweep", color=color.new(color.black, 100), textcolor=colSweep, style=label.style_label_up, size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
// ██ MODULE 2: FAIR VALUE GAPS (FVG)
// ══════════════════════════════════════════════════════════════════════════════
type FvgData
    box     bx
    line    ceLine
    float   top
    float   bot
    float   ce
    int     dir       // 1 = bullish, -1 = bearish
    bool    mitigated
    int     birthBar

var array<FvgData> activeFVGs = array.new<FvgData>()

var bool currentBarHasBullFVG = false
var bool currentBarHasBearFVG = false
currentBarHasBullFVG := false
currentBarHasBearFVG := false

if confirmed and showFVG and bar_index > 2
    float c1High = high[2]
    float c3Low  = low
    float c1Low  = low[2]
    float c3High = high

    if c3Low > c1High
        float fvgHeight = c3Low - c1High
        if fvgHeight >= fvgMinMult * atrVal
            currentBarHasBullFVG := true
            float ceVal = (c3Low + c1High) / 2.0
            bx = box.new(bar_index - 2, c3Low, bar_index + 20, c1High, border_color=colBullFVG, bgcolor=color.new(colBullFVG, 88), border_width=1)
            cl = fvgShowCE ? line.new(bar_index - 2, ceVal, bar_index + 20, ceVal, color=color.new(colBullFVG, 60), style=line.style_dotted, width=1) : na
            newFvg = FvgData.new(bx, cl, c3Low, c1High, ceVal, 1, false, bar_index)
            array.push(activeFVGs, newFvg)

    if c3High < c1Low
        float fvgHeight = c1Low - c3High
        if fvgHeight >= fvgMinMult * atrVal
            currentBarHasBearFVG := true
            float ceVal = (c1Low + c3High) / 2.0
            bx = box.new(bar_index - 2, c1Low, bar_index + 20, c3High, border_color=colBearFVG, bgcolor=color.new(colBearFVG, 88), border_width=1)
            cl = fvgShowCE ? line.new(bar_index - 2, ceVal, bar_index + 20, ceVal, color=color.new(colBearFVG, 60), style=line.style_dotted, width=1) : na
            newFvg = FvgData.new(bx, cl, c1Low, c3High, ceVal, -1, false, bar_index)
            array.push(activeFVGs, newFvg)

if confirmed and array.size(activeFVGs) > 0
    for i = array.size(activeFVGs) - 1 to 0
        fvg = array.get(activeFVGs, i)
        if not fvg.mitigated
            box.set_right(fvg.bx, bar_index + 5)
            if not na(fvg.ceLine)
                line.set_x2(fvg.ceLine, bar_index + 5)

            if fvg.dir == 1 and low <= fvg.ce
                fvg.mitigated := true
                box.set_right(fvg.bx, bar_index)
                if not na(fvg.ceLine)
                    line.set_x2(fvg.ceLine, bar_index)
                box.set_bgcolor(fvg.bx, color.new(colBullFVG, 96))
                box.set_border_color(fvg.bx, color.new(colBullFVG, 80))
            else if fvg.dir == -1 and high >= fvg.ce
                fvg.mitigated := true
                box.set_right(fvg.bx, bar_index)
                if not na(fvg.ceLine)
                    line.set_x2(fvg.ceLine, bar_index)
                box.set_bgcolor(fvg.bx, color.new(colBearFVG, 96))
                box.set_border_color(fvg.bx, color.new(colBearFVG, 80))

if array.size(activeFVGs) > fvgMaxCount * 2
    for i = 0 to math.min(array.size(activeFVGs) - 1, array.size(activeFVGs) - fvgMaxCount * 2)
        old = array.get(activeFVGs, 0)
        box.delete(old.bx)
        if not na(old.ceLine)
            line.delete(old.ceLine)
        array.remove(activeFVGs, 0)

// ══════════════════════════════════════════════════════════════════════════════
// ██ MODULE 3: INSTITUTIONAL ORDER BLOCKS (OB) — 50% MEAN THRESHOLD (MT) LOCK
// ══════════════════════════════════════════════════════════════════════════════
type ObData
    box     bx
    label   lbl
    float   top
    float   bot
    float   mt          // 50% Mean Threshold Level
    int     dir         // 1 = Bullish Demand, -1 = Bearish Supply
    bool    mitigated
    int     birthBar
    int     score       // 1-5 confluence rating
    string  tagText

// Persistent storage: Active (extending) vs Historical (frozen at tap bar)
var array<ObData> activeOBs     = array.new<ObData>()
var array<ObData> historicalOBs = array.new<ObData>()

bool isBullishDisplacement = confirmed and (close > open) and ((high - low) >= obDispMult * atrVal)
bool isBearishDisplacement = confirmed and (close < open) and ((high - low) >= obDispMult * atrVal)

// ── OB Creation Engine ──
if confirmed and showOB

    // ═══ BULLISH DEMAND ORDER BLOCK ═══
    if isBullishDisplacement
        bool foundOrigin = false
        float obTop = na
        float obBot = na
        int   obBar = na

        for j = 1 to 5
            if close[j] < open[j] and not foundOrigin
                obTop := high[j]
                obBot := low[j]
                obBar := bar_index - j
                foundOrigin := true
                break

        if foundOrigin
            int score = 1 // Passed displacement threshold

            if currentBarHasBullFVG
                score += 1
            if bullBOS_signal or bullCHoCH_signal
                score += 1

            bool hadSweep = false
            for k = 0 to 10
                if bar_index - k >= 0 and not na(lastSwingLow)
                    if low[k] < lastSwingLow and close[k] >= lastSwingLow
                        hadSweep := true
                        break
            if hadSweep or bearSweep_signal
                score += 1

            if volume > ta.sma(volume, 20) * 1.5
                score += 1

            if score >= 2
                float obMt   = (obTop + obBot) / 2.0
                string tag   = "OB ▲ [" + str.tostring(score) + "★]"
                color  col   = score >= 4 ? colBullOB : color.new(colBullOB, 25)
                bx  = box.new(obBar, obTop, bar_index + 20, obBot, border_color=col, bgcolor=color.new(colBullOB, 86), border_width=score >= 4 ? 2 : 1)
                lbl = label.new(obBar, obBot, tag, color=color.new(color.black, 100), textcolor=col, style=label.style_label_up, size=size.tiny)
                newOb = ObData.new(bx, lbl, obTop, obBot, obMt, 1, false, obBar, score, tag)
                array.push(activeOBs, newOb)

    // ═══ BEARISH SUPPLY ORDER BLOCK ═══
    if isBearishDisplacement
        bool foundOrigin = false
        float obTop = na
        float obBot = na
        int   obBar = na

        for j = 1 to 5
            if close[j] > open[j] and not foundOrigin
                obTop := high[j]
                obBot := low[j]
                obBar := bar_index - j
                foundOrigin := true
                break

        if foundOrigin
            int score = 1

            if currentBarHasBearFVG
                score += 1
            if bearBOS_signal or bearCHoCH_signal
                score += 1

            bool hadSweep = false
            for k = 0 to 10
                if bar_index - k >= 0 and not na(lastSwingHigh)
                    if high[k] > lastSwingHigh and close[k] <= lastSwingHigh
                        hadSweep := true
                        break
            if hadSweep or bullSweep_signal
                score += 1

            if volume > ta.sma(volume, 20) * 1.5
                score += 1

            if score >= 2
                float obMt   = (obTop + obBot) / 2.0
                string tag   = "OB ▼ [" + str.tostring(score) + "★]"
                color  col   = score >= 4 ? colBearOB : color.new(colBearOB, 25)
                bx  = box.new(obBar, obTop, bar_index + 20, obBot, border_color=col, bgcolor=color.new(colBearOB, 86), border_width=score >= 4 ? 2 : 1)
                lbl = label.new(obBar, obTop, tag, color=color.new(color.black, 100), textcolor=col, style=label.style_label_down, size=size.tiny)
                newOb = ObData.new(bx, lbl, obTop, obBot, obMt, -1, false, obBar, score, tag)
                array.push(activeOBs, newOb)

// ── OB Mitigation Audit & Dynamic Right Boundary Lock ──
if confirmed and array.size(activeOBs) > 0
    for i = array.size(activeOBs) - 1 to 0
        ob = array.get(activeOBs, i)

        if not ob.mitigated
            // Check exact mitigation condition
            bool isTapped = false

            if ob.dir == 1 // Bullish Demand Zone
                if obMitTrigger == "50% Mean Threshold (MT)"
                    isTapped := (low <= ob.mt)
                else if obMitTrigger == "First Touch (Wick Entry)"
                    isTapped := (low <= ob.top)
                else // Full Breakout (Invalidation)
                    isTapped := (close < ob.bot)

            else // Bearish Supply Zone
                if obMitTrigger == "50% Mean Threshold (MT)"
                    isTapped := (high >= ob.mt)
                else if obMitTrigger == "First Touch (Wick Entry)"
                    isTapped := (high >= ob.bot)
                else // Full Breakout (Invalidation)
                    isTapped := (close > ob.top)

            if isTapped
                // 🛑 FREEZE RIGHT BOUNDARY AT EXACT TAP BAR
                ob.mitigated := true
                box.set_right(ob.bx, bar_index)

                if showHistoricalOB
                    // Historical Archive Styling: Dashed, Subtle Opacity
                    color baseCol = ob.dir == 1 ? colBullOB : colBearOB
                    box.set_bgcolor(ob.bx, color.new(baseCol, 93))
                    box.set_border_color(ob.bx, color.new(colMitOB, 50))
                    box.set_border_style(ob.bx, line.style_dashed)
                    box.set_border_width(ob.bx, 1)
                    label.set_text(ob.lbl, ob.tagText)
                    label.set_textcolor(ob.lbl, color.new(baseCol, 40))

                    // Transfer to historical archive
                    array.push(historicalOBs, ob)
                    array.remove(activeOBs, i)
                else
                    // Remove if user disabled historical zones
                    box.delete(ob.bx)
                    label.delete(ob.lbl)
                    array.remove(activeOBs, i)

            else
                // Keep extending active unmitigated zones into live price action
                box.set_right(ob.bx, bar_index + 4)

// ── FIFO Memory Management (Prevent TradingView Box Buffer Overflow) ──
while array.size(activeOBs) > obMaxActive
    old = array.get(activeOBs, 0)
    box.delete(old.bx)
    label.delete(old.lbl)
    array.remove(activeOBs, 0)

while array.size(historicalOBs) > obMaxHistorical
    oldH = array.get(historicalOBs, 0)
    box.delete(oldH.bx)
    label.delete(oldH.lbl)
    array.remove(historicalOBs, 0)

// ══════════════════════════════════════════════════════════════════════════════
// ██ MODULE 4: LIQUIDITY & INDUCEMENT (IDM)
// ══════════════════════════════════════════════════════════════════════════════
if confirmed and showEQHL and not na(lastSwingHigh) and not na(prevSwingHigh)
    float tolerance = lastSwingHigh * (eqTolerance / 100.0)
    if math.abs(lastSwingHigh - prevSwingHigh) <= tolerance
        float eqLevel = math.max(lastSwingHigh, prevSwingHigh)
        line.new(prevSwingHighBar, eqLevel, bar_index + 5, eqLevel, color=color.new(#FF5722, 40), style=line.style_dotted, width=1)
        label.new(bar_index, eqLevel, "EQH ═══", color=color.new(color.black, 100), textcolor=color.new(#FF5722, 30), style=label.style_label_down, size=size.tiny)

if confirmed and showEQHL and not na(lastSwingLow) and not na(prevSwingLow)
    float tolerance = lastSwingLow * (eqTolerance / 100.0)
    if math.abs(lastSwingLow - prevSwingLow) <= tolerance
        float eqLevel = math.min(lastSwingLow, prevSwingLow)
        line.new(prevSwingLowBar, eqLevel, bar_index + 5, eqLevel, color=color.new(#FF5722, 40), style=line.style_dotted, width=1)
        label.new(bar_index, eqLevel, "EQL ═══", color=color.new(color.black, 100), textcolor=color.new(#FF5722, 30), style=label.style_label_up, size=size.tiny)

var float idmLevel = na
var int   idmBar   = na
var int   idmDir   = 0

if confirmed and showIDM
    if bullBOS_signal
        idmLevel := lastSwingLow
        idmBar   := lastSwingLowBar
        idmDir   := 1

    if bearBOS_signal
        idmLevel := lastSwingHigh
        idmBar   := lastSwingHighBar
        idmDir   := -1

    if not na(idmLevel) and not na(idmBar)
        if idmDir == 1 and not na(swingLow) and bar_index - pivotOffset > idmBar
            line.new(idmBar, idmLevel, bar_index + 3, idmLevel, color=colIDM, style=line.style_dotted, width=1)
            label.new(bar_index, idmLevel, "IDM 🪤", color=color.new(color.black, 100), textcolor=colIDM, style=label.style_label_up, size=size.tiny)
            idmLevel := na

        if idmDir == -1 and not na(swingHigh) and bar_index - pivotOffset > idmBar
            line.new(idmBar, idmLevel, bar_index + 3, idmLevel, color=colIDM, style=line.style_dotted, width=1)
            label.new(bar_index, idmLevel, "IDM 🪤", color=color.new(color.black, 100), textcolor=colIDM, style=label.style_label_down, size=size.tiny)
            idmLevel := na

// ══════════════════════════════════════════════════════════════════════════════
// ██ MODULE 5: PREMIUM / DISCOUNT & OTE DEALING RANGE
// ══════════════════════════════════════════════════════════════════════════════
var float dealingHigh  = na
var float dealingLow   = na
var box   premiumBox   = na
var box   discountBox  = na
var line  eqLine       = na
var line  oteLine618   = na
var line  oteLine705   = na
var line  oteLine786   = na
var label eqLabel      = na

if confirmed and showPD and not na(lastSwingHigh) and not na(lastSwingLow)
    bool rangeChanged = (lastSwingHigh != dealingHigh or lastSwingLow != dealingLow)

    if rangeChanged
        dealingHigh := lastSwingHigh
        dealingLow  := lastSwingLow
        float eq    = (dealingHigh + dealingLow) / 2.0

        if not na(premiumBox)
            box.delete(premiumBox)
        if not na(discountBox)
            box.delete(discountBox)
        if not na(eqLine)
            line.delete(eqLine)
        if not na(eqLabel)
            label.delete(eqLabel)
        if not na(oteLine618)
            line.delete(oteLine618)
        if not na(oteLine705)
            line.delete(oteLine705)
        if not na(oteLine786)
            line.delete(oteLine786)

        int leftBar  = math.max(lastSwingHighBar, lastSwingLowBar)
        int rightBar = bar_index + 30

        premiumBox  := box.new(leftBar, dealingHigh, rightBar, eq, border_color=color.new(colPremium, 90), bgcolor=colPremium)
        discountBox := box.new(leftBar, eq, rightBar, dealingLow, border_color=color.new(colDiscount, 90), bgcolor=colDiscount)
        eqLine      := line.new(leftBar, eq, rightBar, eq, color=colEQ, style=line.style_solid, width=2)
        eqLabel     := label.new(rightBar, eq, "─── EQ ───", color=color.new(color.black, 100), textcolor=colEQ, style=label.style_label_left, size=size.tiny)

        if showOTE
            float dealingRange = dealingHigh - dealingLow
            float ote618 = dealingLow + dealingRange * 0.382
            float ote705 = dealingLow + dealingRange * 0.295
            float ote786 = dealingLow + dealingRange * 0.214

            oteLine618 := line.new(leftBar, ote618, rightBar, ote618, color=color.new(#FFD700, 50), style=line.style_dotted, width=1)
            oteLine705 := line.new(leftBar, ote705, rightBar, ote705, color=color.new(#FFD700, 40), style=line.style_dotted, width=1)
            oteLine786 := line.new(leftBar, ote786, rightBar, ote786, color=color.new(#FFD700, 30), style=line.style_dotted, width=1)

    else
        if not na(premiumBox)
            box.set_right(premiumBox, bar_index + 30)
        if not na(discountBox)
            box.set_right(discountBox, bar_index + 30)
        if not na(eqLine)
            line.set_x2(eqLine, bar_index + 30)
        if not na(eqLabel)
            label.set_x(eqLabel, bar_index + 30)
        if not na(oteLine618)
            line.set_x2(oteLine618, bar_index + 30)
        if not na(oteLine705)
            line.set_x2(oteLine705, bar_index + 30)
        if not na(oteLine786)
            line.set_x2(oteLine786, bar_index + 30)

// ══════════════════════════════════════════════════════════════════════════════
// ██ MODULE 6: ALERT SYSTEM (INSTITUTIONAL TRIGGERS)
// ══════════════════════════════════════════════════════════════════════════════
alertcondition(bullBOS_signal,   "Bullish BOS",   "⚡ Hermes SMC: Bullish Break of Structure confirmed!")
alertcondition(bearBOS_signal,   "Bearish BOS",   "⚡ Hermes SMC: Bearish Break of Structure confirmed!")
alertcondition(bullCHoCH_signal, "Bullish CHoCH",  "🔄 Hermes SMC: Bullish Change of Character — Potential Reversal!")
alertcondition(bearCHoCH_signal, "Bearish CHoCH",  "🔄 Hermes SMC: Bearish Change of Character — Potential Reversal!")
alertcondition(bullSweep_signal, "Bullish Sweep",  "⚡ Hermes SMC: Liquidity Sweep above swing high!")
alertcondition(bearSweep_signal, "Bearish Sweep",  "⚡ Hermes SMC: Liquidity Sweep below swing low!")
alertcondition(isBullishDisplacement, "Bullish Displacement", "💥 Hermes SMC: Bullish Displacement detected!")
alertcondition(isBearishDisplacement, "Bearish Displacement", "💥 Hermes SMC: Bearish Displacement detected!")

// ══════════════════════════════════════════════════════════════════════════════
// ██ WATERMARK
// ══════════════════════════════════════════════════════════════════════════════
var table watermark = table.new(position.bottom_right, 1, 1)
if barstate.islast
    table.cell(watermark, 0, 0, "⚡ Hermes SMC Engine v1.0", text_color=color.new(#FFD700, 40), text_size=size.small)
