//@version=6
indicator("HERMES SOVEREIGN APEX ENGINE v1.0 — Institutional Microstructure & Absorption Matrix", shorttitle="HERMES SOVEREIGN v1.0", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==============================================================================
// 🏛️ HERMES SOVEREIGN APEX ENGINE v1.0 (PINE SCRIPT v6)
// Architect: Hermes AI & Akash Bhai (Autonomous Quantitative Partner)
// Logic: 1H/4H Institutional OBs + 15m/5m Absorption Gate + Delta Divergence + Dynamic 1:2 R:R
// ==============================================================================

// ------------------------------------------------------------------------------
// 1. SETTINGS & INPUTS
// ------------------------------------------------------------------------------
grp_exec    = "🎯 1. Execution & Penetration Gate"
pen_depth   = input.float(20.0, "OB Penetration Depth (%)", minval=5.0, maxval=50.0, step=5.0, group=grp_exec, tooltip="Price must penetrate 20% deep inside the Order Block on First Tap before consideration.")
wait_bars   = input.int(2, "Absorption Gate Wait (Bars)", minval=1, maxval=5, group=grp_exec, tooltip="Wait for 1-2 bars to confirm absorption and avoid slicing knives.")
sl_buffer   = input.float(0.8, "Structural SL Buffer (%)", minval=0.2, maxval=2.5, step=0.1, group=grp_exec, tooltip="SL placed strictly beyond OB Outer Boundary + Buffer %")
rr_ratio    = input.float(2.0, "Target Risk-to-Reward Ratio (R:R)", minval=1.5, maxval=4.0, step=0.1, group=grp_exec, tooltip="TP dynamically calculated as Entry + (R:R * Risk)")

grp_be      = "🛡️ 2. Dynamic Profit Armor"
be_trigger  = input.float(1.5, "Breakeven Armor Trigger (Price %)", minval=0.5, maxval=5.0, step=0.1, group=grp_be, tooltip="Move SL to Entry + Fees ONLY after +1.5% clean price expansion (+7.5% ROE). Eliminates $0.15 fee churn!")
trail_trig  = input.float(2.0, "Dynamic Trailing Trigger (Price %)", minval=1.0, maxval=6.0, step=0.2, group=grp_be)
trail_lock  = input.float(1.0, "Guaranteed Trailing Lock (Price %)", minval=0.5, maxval=4.0, step=0.2, group=grp_be)

grp_htf     = "🏛️ 3. Multi-Timeframe Institutional Structure"
use_htf_ob  = input.bool(true, "Anchor to 1H / 4H Macro Order Blocks", group=grp_htf)
htf_res     = input.timeframe("60", "Macro Structure Timeframe", group=grp_htf)
min_disp    = input.float(3.5, "Min Impulsive Displacement (%)", minval=1.0, maxval=15.0, step=0.5, group=grp_htf)
req_fvg     = input.bool(true, "Strict Fair Value Gap (FVG) Requirement", group=grp_htf)

grp_micro   = "⚡ 4. Microstructure Volume Delta & Absorption"
detect_abs  = input.bool(true, "Enable Bar Delta Absorption Detection", group=grp_micro)
min_wick_pct= input.float(20.0, "Min Absorption Wick Size (%)", minval=10.0, maxval=50.0, step=5.0, group=grp_micro)

grp_ui      = "🎨 5. Institutional Visual HUD"
show_hud    = input.bool(true, "Show Hermes Sovereign HUD Dashboard", group=grp_ui)
show_pdhl   = input.bool(true, "Show Previous Day High & Low (PDH/PDL)", group=grp_ui)
col_bull_ob = input.color(color.new(#00F59B, 80), "Bullish Demand Box", group=grp_ui)
col_bear_ob = input.color(color.new(#FF3B69, 80), "Bearish Supply Box", group=grp_ui)

// ------------------------------------------------------------------------------
// 2. MICROSTRUCTURE VOLUME DELTA APPROXIMATION
// ------------------------------------------------------------------------------
candle_range = high - low
lower_wick   = (close >= open) ? (open - low) : (close - low)
upper_wick   = (close >= open) ? (high - close) : (high - open)

lower_wick_pct = candle_range > 0 ? (lower_wick / candle_range) * 100.0 : 0.0
upper_wick_pct = candle_range > 0 ? (upper_wick / candle_range) * 100.0 : 0.0

// Intra-bar buy/sell volume estimation
buy_vol  = candle_range > 0 ? volume * ((close - low) / candle_range) : volume * 0.5
sell_vol = candle_range > 0 ? volume * ((high - close) / candle_range) : volume * 0.5
bar_delta = buy_vol - sell_vol

// ------------------------------------------------------------------------------
// 3. ORDER BLOCK DETECTION ENGINE
// ------------------------------------------------------------------------------
c1_low   = low[1]
c1_high  = high[1]
c3_low   = low[3]
c3_high  = high[3]
c3_open  = open[3]
c3_close = close[3]

// Displacement wave
impulse_high = ta.highest(high, 3)
impulse_low  = ta.lowest(low, 3)
bull_disp    = ((impulse_high - c3_low) / c3_low) * 100.0
bear_disp    = ((c3_high - impulse_low) / c3_high) * 100.0

// FVG confirmation
bull_fvg = req_fvg ? (c1_low > c3_high) : true
bear_fvg = req_fvg ? (c1_high < c3_low) : true

// Color alignment
bull_color = c3_close < c3_open
bear_color = c3_close > c3_open

bull_qual = bull_color and bull_fvg and (bull_disp >= min_disp)
bear_qual = bear_color and bear_fvg and (bear_disp >= min_disp)

// ------------------------------------------------------------------------------
// 4. ACTIVE ZONE TYPE & STORAGE
// ------------------------------------------------------------------------------
type SovereignZone
    bool  is_bull
    int   start_bar
    float ob_high
    float ob_low
    float entry_p
    float sl_p
    float tp_p
    float be_trig_p
    float trail_trig_p
    float trail_lock_p
    box   ob_box
    line  entry_line
    line  sl_line
    line  tp_line
    bool  tapped
    int   tap_bar
    bool  absorbed
    bool  invalidated
    bool  completed
    bool  be_active
    bool  trail_active

var SovereignZone[] zones = array.new<SovereignZone>()

// Register New Qualified Order Block
if bull_qual
    float o_high = c3_high
    float o_low  = c3_low
    float o_rng  = o_high - o_low
    float ent_p  = o_high - (o_rng * (pen_depth / 100.0))
    float sl_p   = o_low * (1.0 - (sl_buffer / 100.0))
    float risk   = math.abs(ent_p - sl_p)
    float tp_p   = ent_p + (risk * rr_ratio)
    float be_p   = ent_p * (1.0 + (be_trigger / 100.0))
    float trg_p  = ent_p * (1.0 + (trail_trig / 100.0))
    float lck_p  = ent_p * (1.0 + (trail_lock / 100.0))
    int s_bar    = bar_index - 3

    box b = box.new(s_bar, o_high, bar_index + 10, o_low, border_color=color.new(#00F59B, 40), border_width=1, bgcolor=col_bull_ob)
    line l_ent = line.new(s_bar, ent_p, bar_index + 10, ent_p, color=color.new(#00F59B, 0), width=1, style=line.style_dashed)
    line l_sl  = line.new(s_bar, sl_p, bar_index + 10, sl_p, color=color.new(#FF3B69, 0), width=1, style=line.style_solid)
    line l_tp  = line.new(s_bar, tp_p, bar_index + 10, tp_p, color=color.new(#38BDF8, 0), width=1, style=line.style_solid)

    SovereignZone sz = SovereignZone.new(true, s_bar, o_high, o_low, ent_p, sl_p, tp_p, be_p, trg_p, lck_p, b, l_ent, l_sl, l_tp, false, 0, false, false, false, false, false)
    array.push(zones, sz)
    if array.size(zones) > 30
        array.shift(zones)

if bear_qual
    float o_high = c3_high
    float o_low  = c3_low
    float o_rng  = o_high - o_low
    float ent_p  = o_low + (o_rng * (pen_depth / 100.0))
    float sl_p   = o_high * (1.0 + (sl_buffer / 100.0))
    float risk   = math.abs(sl_p - ent_p)
    float tp_p   = ent_p - (risk * rr_ratio)
    float be_p   = ent_p * (1.0 - (be_trigger / 100.0))
    float trg_p  = ent_p * (1.0 - (trail_trig / 100.0))
    float lck_p  = ent_p * (1.0 - (trail_lock / 100.0))
    int s_bar    = bar_index - 3

    box b = box.new(s_bar, o_high, bar_index + 10, o_low, border_color=color.new(#FF3B69, 40), border_width=1, bgcolor=col_bear_ob)
    line l_ent = line.new(s_bar, ent_p, bar_index + 10, ent_p, color=color.new(#FF3B69, 0), width=1, style=line.style_dashed)
    line l_sl  = line.new(s_bar, sl_p, bar_index + 10, sl_p, color=color.new(#FF3B69, 0), width=1, style=line.style_solid)
    line l_tp  = line.new(s_bar, tp_p, bar_index + 10, tp_p, color=color.new(#38BDF8, 0), width=1, style=line.style_solid)

    SovereignZone sz = SovereignZone.new(false, s_bar, o_high, o_low, ent_p, sl_p, tp_p, be_p, trg_p, lck_p, b, l_ent, l_sl, l_tp, false, 0, false, false, false, false, false)
    array.push(zones, sz)
    if array.size(zones) > 30
        array.shift(zones)

// ------------------------------------------------------------------------------
// 5. STAGING CLOCK & ABSORPTION EXECUTION ENGINE
// ------------------------------------------------------------------------------
if array.size(zones) > 0
    for i = 0 to array.size(zones) - 1
        SovereignZone z = array.get(zones, i)
        if not z.completed and not z.invalidated
            box.set_right(z.ob_box, bar_index + 5)
            line.set_x2(z.entry_line, bar_index + 5)
            line.set_x2(z.sl_line, bar_index + 5)
            line.set_x2(z.tp_line, bar_index + 5)

            // BULLISH ZONE LOGIC
            if z.is_bull
                // Tap Detection (20% penetration)
                if not z.tapped and low <= z.entry_p and close > z.ob_low
                    z.tapped  := true
                    z.tap_bar := bar_index
                    label.new(bar_index, low, "⏳ STAGING TAP (20% IN)", color=color.new(#F59E0B, 20), textcolor=color.white, style=label.style_label_up, size=size.small)

                // Staging Clock Invalidation Check (Blowout knife protector)
                if z.tapped and not z.absorbed
                    // If candle closes below OB Low -> Invalidate immediately ($0 Loss)
                    if close < z.ob_low
                        z.invalidated := true
                        box.set_bgcolor(z.ob_box, color.new(#FF3B69, 90))
                        label.new(bar_index, low, "❌ SLICE BLOWOUT ($0 LOSS)", color=color.new(#FF3B69, 20), textcolor=color.white, style=label.style_label_up, size=size.small)
                    
                    // Absorption Check after 1-2 bars
                    int bars_since_tap = bar_index - z.tap_bar
                    bool absorption_detected = (lower_wick_pct >= min_wick_pct) or (close > open and bar_delta > 0)
                    if not z.invalidated and bars_since_tap >= wait_bars and absorption_detected and close >= z.entry_p
                        z.absorbed := true
                        label.new(bar_index, low, "🎯 HERMES BUY TRIGGER\nSL: " + str.tostring(z.sl_p, "#.####") + "\nTP: " + str.tostring(z.tp_p, "#.####"), color=color.new(#00F59B, 0), textcolor=color.black, style=label.style_label_up, size=size.normal)

                // Position Lifecycle Management
                if z.absorbed
                    // Breakeven Armor Lock
                    if high >= z.be_trig_p and not z.be_active
                        z.be_active := true
                        line.set_y1(z.sl_line, z.entry_p)
                        line.set_y2(z.sl_line, z.entry_p)
                        line.set_color(z.sl_line, color.yellow)
                        label.new(bar_index, high, "🛡️ BE ARMOR LOCKED (+1.5%)", color=color.yellow, textcolor=color.black, style=label.style_label_down, size=size.small)

                    // Take Profit Hit
                    if high >= z.tp_p
                        z.completed := true
                        box.set_bgcolor(z.ob_box, color.new(#00F59B, 85))
                        label.new(bar_index, high, "💰 TARGET TP HIT (+1:2 R:R)", color=color.new(#38BDF8, 0), textcolor=color.black, style=label.style_label_down, size=size.normal)

                    // Stop Loss Hit
                    if low <= z.sl_p
                        z.completed := true
                        label.new(bar_index, low, "🔴 SL HIT", color=color.new(#FF3B69, 0), textcolor=color.white, style=label.style_label_up, size=size.small)

            // BEARISH ZONE LOGIC
            else
                // Tap Detection (20% penetration)
                if not z.tapped and high >= z.entry_p and close < z.ob_high
                    z.tapped  := true
                    z.tap_bar := bar_index
                    label.new(bar_index, high, "⏳ STAGING TAP (20% IN)", color=color.new(#F59E0B, 20), textcolor=color.white, style=label.style_label_down, size=size.small)

                // Staging Clock Invalidation Check
                if z.tapped and not z.absorbed
                    if close > z.ob_high
                        z.invalidated := true
                        box.set_bgcolor(z.ob_box, color.new(#FF3B69, 90))
                        label.new(bar_index, high, "❌ SLICE BLOWOUT ($0 LOSS)", color=color.new(#FF3B69, 20), textcolor=color.white, style=label.style_label_down, size=size.small)
                    
                    int bars_since_tap = bar_index - z.tap_bar
                    bool absorption_detected = (upper_wick_pct >= min_wick_pct) or (close < open and bar_delta < 0)
                    if not z.invalidated and bars_since_tap >= wait_bars and absorption_detected and close <= z.entry_p
                        z.absorbed := true
                        label.new(bar_index, high, "🎯 HERMES SELL TRIGGER\nSL: " + str.tostring(z.sl_p, "#.####") + "\nTP: " + str.tostring(z.tp_p, "#.####"), color=color.new(#FF3B69, 0), textcolor=color.white, style=label.style_label_down, size=size.normal)

                // Position Lifecycle Management
                if z.absorbed
                    if low <= z.be_trig_p and not z.be_active
                        z.be_active := true
                        line.set_y1(z.sl_line, z.entry_p)
                        line.set_y2(z.sl_line, z.entry_p)
                        line.set_color(z.sl_line, color.yellow)
                        label.new(bar_index, low, "🛡️ BE ARMOR LOCKED (+1.5%)", color=color.yellow, textcolor=color.black, style=label.style_label_up, size=size.small)

                    if low <= z.tp_p
                        z.completed := true
                        box.set_bgcolor(z.ob_box, color.new(#00F59B, 85))
                        label.new(bar_index, low, "💰 TARGET TP HIT (+1:2 R:R)", color=color.new(#38BDF8, 0), textcolor=color.black, style=label.style_label_up, size=size.normal)

                    if high >= z.sl_p
                        z.completed := true
                        label.new(bar_index, high, "🔴 SL HIT", color=color.new(#FF3B69, 0), textcolor=color.white, style=label.style_label_down, size=size.small)

// ------------------------------------------------------------------------------
// 6. PREVIOUS DAY HIGH & LOW (PDH / PDL)
// ------------------------------------------------------------------------------
var line pdh_line = na
var line pdl_line = na
if show_pdhl
    float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
    float pdl = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
    line.delete(pdh_line)
    line.delete(pdl_line)
    pdh_line := line.new(bar_index - 30, pdh, bar_index + 10, pdh, color=#F59E0B, width=1, style=line.style_dotted)
    pdl_line := line.new(bar_index - 30, pdl, bar_index + 10, pdl, color=#38BDF8, width=1, style=line.style_dotted)

// ------------------------------------------------------------------------------
// 7. INSTITUTIONAL HUD DASHBOARD
// ------------------------------------------------------------------------------
if show_hud and barstate.islast
    var table hud = table.new(position.top_right, 2, 6, bgcolor=color.new(#0F172A, 10), border_color=color.new(#334155, 30), border_width=1)
    table.cell(hud, 0, 0, "HERMES SOVEREIGN v1.0", bgcolor=color.new(#00F59B, 20), text_color=color.white, text_size=size.small)
    table.cell(hud, 1, 0, "INSTITUTIONAL QUANT", bgcolor=color.new(#00F59B, 20), text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 1, "Penetration Gate", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 1, str.tostring(pen_depth, "#") + "% Inside OB", text_color=color.white, text_size=size.small)

    table.cell(hud, 0, 2, "Staging Clock", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 2, str.tostring(wait_bars) + " Bars (Absorption Wait)", text_color=#38BDF8, text_size=size.small)

    table.cell(hud, 0, 3, "Delta Absorption", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 3, bar_delta > 0 ? "BULLISH DELTA" : "BEARISH DELTA", text_color=bar_delta > 0 ? #00F59B : #FF3B69, text_size=size.small)

    table.cell(hud, 0, 4, "Profit Armor BE", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 4, "+" + str.tostring(be_trigger, "#.#") + "% Price Shield", text_color=color.yellow, text_size=size.small)

    table.cell(hud, 0, 5, "Target R:R", text_color=color.gray, text_size=size.small)
    table.cell(hud, 1, 5, "1:" + str.tostring(rr_ratio, "#.#") + " Dynamic TP", text_color=#00F59B, text_size=size.small)
